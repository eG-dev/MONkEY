@inject IJSRuntime JSRuntime

 <MudContainer Class="d-flex flex-column align-center pb-3" MaxWidth="MaxWidth.Medium">
    <MudImage Src="images/monkey_face.png" Width="256" Height="256"></MudImage>

    <MudBreakpointProvider Class="mt-6">
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudText Typo="Typo.h5" Align="Align.Center">Willkommen bei POCKET MONkEY!</MudText>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.Sm" Invert="true">
            <MudText Typo="Typo.h4" Align="Align.Center">Willkommen bei POCKET MONkEY!</MudText>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <MudText Typo="Typo.h3" Align="Align.Center">Willkommen bei POCKET MONkEY!</MudText>
        </MudHidden>
    </MudBreakpointProvider>

    <MudText Class="mt-6" Typo="Typo.body1" GutterBottom="true" Align="Align.Center">
        Was als kleines Hobbyprojekt zur Verwaltung des Taschengeldes meiner Kinder begann, hat sich zu einer vollwertigen Anwendung entwickelt, die für jeden von Nutzen sein kann.
    </MudText>

    <MudText Class="mt-6" Typo="Typo.h6" Align="Align.Center">
        Welchen Mehrwert bietet POCKET MONkEY?
    </MudText>
    <MudText Class="mt-3" Typo="Typo.body1" GutterBottom="true" Align="Align.Center">
        <strong>Deine Kinder haben zu viel Bargeld zuhause?</strong>
        <br />
        Ziehe das überschüssige Bargeld ein, lege es z. B. auf ein Tagesgeldkonto und verbuche die Einzahlung in POCKET MONkEY.
        <br />
        Wenn das Kind Bargeld benötigt, gib es ihm und trage die Auszahlung in POCKET MONkEY ein.
        <br />
        So behältst Du immer den Überblick über den aktuellen Stand Deiner Taschengeldkonten.
    </MudText>
    <MudText Class="mt-3" Typo="Typo.body1" Align="Align.Center">
        <strong>Du vergisst es immer wieder den Kindern das Taschengeld "gutzuschreiben"?</strong>
        <br />
        Lege das monatliche Taschengeld für jedes Deiner Kinder fest und es wird automatisch im jeweiligen Konto verbucht.
    </MudText>

    <MudText Class="mt-10" Typo="Typo.body1" Align="Align.Center">
        Zusammengefasst ist POCKET MONkEY eine einfache, virtuelle Verwaltungsmöglichkeit und Übersicht für die Kontostände.
        <br />
        Zuverlässiger und komfortabler als eine "Zettelwirtschaft" durch viele nützliche Funktionen:
    </MudText>
    <MudList T="string" ReadOnly="true">
        <MudListItem Text="Dein eigener, geschützter Bereich" SecondaryText="Mit bis zu 9 Taschengeldkonten" IconColor="Color.Primary" Icon="@Icons.Material.TwoTone.Home" />
        <MudListItem Text="Gemeinsame Verwaltung" SecondaryText="Lade andere Familienmitglieder zu Deinem Bereich ein" IconColor="Color.Primary" Icon="@Icons.Material.TwoTone.SupervisedUserCircle" />
        <MudListItem Text="Rollen mit Berechtigungen" SecondaryText="Verwaltung (für Eltern) oder reine Ansicht (für Kinder)" IconColor="Color.Success" Icon="@Icons.Material.TwoTone.AdminPanelSettings" />
        <MudListItem Text="Übersicht über alle Transaktionen" SecondaryText="Wer, wieviel, wann und warum?" IconColor="Color.Success" Icon="@Icons.Material.TwoTone.Wallet" />
        <MudListItem Text="Automatische Taschengeld-Buchung" SecondaryText="Monatlich in der von Dir festgelegten Höhe" IconColor="Color.Secondary" Icon="@Icons.Material.TwoTone.AutoMode" />
        <MudListItem Text="Monatliche Berichte" SecondaryText="Auf Wunsch per E-Mail zugeschickt" IconColor="Color.Warning" Icon="@Icons.Material.TwoTone.Email" />
    </MudList>

    <MudButton Class="mt-10" Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Custom.Brands.Microsoft"
               Href="MicrosoftIdentity/Account/SignIn">
        Anmelden
    </MudButton>

    <MudText Class="mt-3" Align="Align.Center" GutterBottom="true">
        Wenn Du fortfährst, erklärst Du Dich mit den
        <MudLink Href="/terms/usage-terms" Underline="Underline.None">Nutzungsbedingungen</MudLink>
        und der
        <MudLink Href="/terms/data-privacy" Underline="Underline.None">Datenschutzerklärung</MudLink>
        einverstanden.
    </MudText>

    <MudText Class="mt-10" Align="Align.Center" GutterBottom="true">Hast Du Fragen oder Anregungen?</MudText>
    <MudGrid Spacing="3" Justify="Justify.Center">
        <MudItem>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       style="text-transform: none;"
                       StartIcon="@Icons.Material.TwoTone.Email"
                       Href="mailto:info@pocket-monkey.de">
                info@pocket-monkey.de
            </MudButton>
        </MudItem>
        <MudItem>
            <MudButton Variant="Variant.Outlined"
                       style="color: white; background: #0a66c2; border-color: #0a66c2; text-transform: none;"
                       StartIcon="@Icons.Custom.Brands.LinkedIn"
                       Href="https://www.linkedin.com/in/eugen-klerner"
                       Target="_blank">
                Eugen Klerner
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudAlert Class="mt-6" Severity="Severity.Warning">
        Das ist ein Hobbyprojekt, das von mir alleine, für nicht-kommerzielle Zwecke und in meiner Freizeit entwickelt wird!
    </MudAlert>
</MudContainer>
