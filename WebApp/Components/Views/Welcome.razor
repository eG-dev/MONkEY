@inject IJSRuntime JSRuntime

 <MudContainer Class="d-flex flex-column align-center pb-3" MaxWidth="MaxWidth.Medium">
    <MudImage Src="images/monkey_face.png" Width="256" Height="256"></MudImage>

    <MudBreakpointProvider Class="mt-6">
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudText Typo="Typo.h5" Align="Align.Center">Willkommen in der MONkEY App!</MudText>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.Sm" Invert="true">
            <MudText Typo="Typo.h4" Align="Align.Center">Willkommen in der MONkEY App!</MudText>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <MudText Typo="Typo.h3" Align="Align.Center">Willkommen in der MONkEY App!</MudText>
        </MudHidden>
    </MudBreakpointProvider>

    <MudText Class="mt-6" Typo="Typo.body1" GutterBottom="true" Align="Align.Center">
        Was als kleines Hobbyprojekt zur Verwaltung des Taschengelds meiner Kinder begann, hat sich zu einer vollwertigen Anwendung entwickelt, die für jeden von Nutzen sein kann.
    </MudText>
    <MudText Typo="Typo.body1" GutterBottom="true" Align="Align.Center">
        Die MONkEY App ermöglicht es Dir, Deinen persönlichen Finanzbereich zu erstellen und zu verwalten - und nur Du hast Zugriff darauf!
    </MudText>
    <MudText Typo="Typo.body1" Align="Align.Center">
        Egal, ob Du das Taschengeld Deiner Kinder verwalten oder Deine Ausgaben im Blick behalten möchtest, die MONkEY App bietet Dir die Werkzeuge und den Raum dafür.
    </MudText>
    <MudText Class="mt-3" Typo="Typo.body1" Align="Align.Center">
        <strong>Viel Spaß beim Entdecken und Verwalten!</strong>
    </MudText>

    <MudText Class="mt-6" Align="Align.Center">
        Wenn Du fortfährst, erklärst Du Dich mit den
        <MudLink Href="/terms/usage-terms" Underline="Underline.None">Nutzungsbedingungen</MudLink>
        und der
        <MudLink Href="/terms/data-privacy" Underline="Underline.None">Datenschutzerklärung</MudLink>
        einverstanden.
    </MudText>

    <MudText Class="mt-6" Align="Align.Center">Hast Du Fragen oder Anregungen?</MudText>
    <div class="d-flex flex-row justify-center">
        <MudChip T="string" Icon="@Icons.Material.TwoTone.Email" Label="true" Color="Color.Primary" OnClick="GotoEmail">E-Mail</MudChip>
        <MudChip T="string" Icon="@Icons.Custom.Brands.LinkedIn" Label="true" style="color: white; background: #0a66c2;" OnClick="GotoLinkedIn">Eugen Klerner</MudChip>
    </div>

    <MudAlert Class="mt-6" Severity="Severity.Warning">
        Das ist ein Hobbyprojekt, das von mir alleine, für nicht-kommerzielle Zwecke und in meiner Freizeit entwickelt wird!
    </MudAlert>
</MudContainer>

@code {
    private async Task GotoLinkedIn()
    {
        await JSRuntime.InvokeVoidAsync("open", "https://www.linkedin.com/in/eugen-klerner", "_blank");
    }

    private async Task GotoEmail()
    {
        await JSRuntime.InvokeVoidAsync("open", "mailto:info@monkey-app.de?subject=MONkEY%20App", "_blank");
    }
}
