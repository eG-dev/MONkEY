@if (Value != null)
{
    <span style="@GetStyle()">
        @Value.Value.ToString("+0;-#")@Unit
    </span>
}

@code {
    [Parameter]
    public double? Value { get; set; } = null;

    [Parameter]
    public string Unit { get; set; } = string.Empty;

    [Parameter]
    public bool IsBold { get; set; } = false;

    private string GetStyle()
    {
        var color = Value!.Value < 0 ? "var(--mud-palette-error)" : "var(--mud-palette-success)";
        var fontWeight = IsBold ? "font-weight: bold;" : "";

        return $"color: {color}; {fontWeight}";
    }
}
