@if (Value.HasValue)
{
    var value = Value.GetValueOrDefault();
    var cssClass = string.IsNullOrWhiteSpace(Class) ? "" : Class;

    <span class="@cssClass" style="@GetStyle()">
        @FormatValue(value)@Unit
    </span>
}

@code {
    [Parameter]
    public double? Value { get; set; } = null;

    [Parameter]
    public string Unit { get; set; } = string.Empty;

    [Parameter]
    public bool IsBold { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = default!;

    [Parameter]
    public string Style { get; set; } = default!;

    private string GetStyle()
    {
        var value = Value.GetValueOrDefault();

        var color = value == 0
            ? "--mud-palette-text-primary"
            : value < 0
                ? "--mud-palette-error"
                : "--mud-palette-success";

        var fontWeight = IsBold ? "font-weight: bold;" : "";

        var style = $"color: var({color}); {fontWeight};";

        if (string.IsNullOrWhiteSpace(Style))
        {
            style += $" {Style}";
        }

        return style;
    }

    private string FormatValue(double value)
    {
        if (value == 0)
        {
            return "0";
        }

        return value % 1 == 0 
            ? value.ToString("+0;-0") 
            : value.ToString("+0.00;-0.00");
    }
}
