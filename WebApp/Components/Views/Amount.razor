@if (Value != null)
{
    var value = Value.Value;

    <span style="color: var(@(value < 0 ? "--mud-palette-error" : "--mud-palette-success"))">@value.ToString("+0;-#")@Unit</span>
}

@code {
    [Parameter]
    public double? Value { get; set; } = null;

    [Parameter]
    public string Unit { get; set; } = string.Empty;
}
