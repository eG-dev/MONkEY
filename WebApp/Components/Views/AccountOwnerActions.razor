@using MONkEY.Data

@inject TenantManagementService TenantManagement
@inject NavigationManager Navigation

@if (User.Status == AccountOwnerStatus.Undefined)
{
    <div class="d-flex flex-column align-center mt-6">
        <MudImage Class="mb-6" Src="images/monkey_face.png" Width="256" Height="256"></MudImage>
        <MudText Typo="Typo.h5" GutterBottom=true>Du bist neu hier!</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center">Lege einen eigenen Bereich an oder lass dich zu einem bestehenden Bereich einladen.</MudText>
        <MudAlert Class="mt-6" Severity="Severity.Info">
            Willst Du im bestehenden Bereich aufgenommen werden, der jemand anderem gehört?
            <br />
            Dann lass Dich von dieser Person zu diesem Bereich hinzufügen und komme später wieder hierher zurück.
            <br />
            Du bekommst dann hier die Möglichkeit die Einladung anzunehmen.
        </MudAlert>
        <div class="d-flex flex-row align-center mt-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.TwoTone.AddHome"
                       Style="min-width: 150px"
                       OnClick="CreateTenant">
                Eigenen Bereich anlegen
            </MudButton>
        </div>
    </div>
}
else if (User.Status == AccountOwnerStatus.Pending)
{
    <div class="d-flex flex-column align-center mt-6">
        <MudText Typo="Typo.h5">Wunderbar, wir sind fast fertig!</MudText>
        <MudImage Class="my-6" Src="images/monkey_face.png" Width="256" Height="256"></MudImage>
        <MudText Typo="Typo.body1" Align="Align.Center">Lass uns noch schnell die Einrichtung deines Kontos abschließen.</MudText>

        <MudCheckBox @bind-Value="accountOwnerSettings.IsMonthlyReportingEnabled">
            Ich möchte monatliche Berichte per E-Mail erhalten.
        </MudCheckBox>

        <MudAlert Class="my-3" Severity="Severity.Info">
            Du kannst diese Einstellungen auch später jederzeit wieder in den Kontoeinstellungen ändern.
        </MudAlert>

        <div class="d-flex flex-row align-center mt-6">
            <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.TwoTone.CheckCircle"
                       Color="Color.Success"
                       OnClick="ActivateUser">
                Einrichtung abschließen
            </MudButton>
        </div>
    </div>
}
else if (User.Status == AccountOwnerStatus.Invited)
{
    <div class="d-flex flex-column align-center mt-6">
        <MudText Typo="Typo.h5">Du wurdest zu POCKET MONkEY eingeladen!</MudText>
        <MudImage Class="my-6" Src="images/monkey_face.png" Width="256" Height="256"></MudImage>
        <MudAlert Severity="Severity.Info">
            Solltest Du Dich entscheiden die Einladung abzulehnen, werden alle Deine Daten aus dem System gelöscht.
            <br />
            Du bekommst danach die Möglichkeit Deinen eigenen Bereich anzulegen.
        </MudAlert>

        <div class="d-flex flex-row align-center mt-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.TwoTone.ThumbUp"
                       Style="min-width: 150px"
                       OnClick="AcceptInvitation">
                Annehmen
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       Class="ml-3"
                       StartIcon="@Icons.Material.TwoTone.ThumbDown"
                       Style="min-width: 150px"
                       OnClick="DeclineInvitation">
                Ablehnen
            </MudButton>
        </div>
    </div>
}
else if (User.Status == AccountOwnerStatus.Disabled)
{
    <div class="d-flex flex-column align-center mt-6">
        <MudText Typo="Typo.h5">Dein Nutzer wurde vom Administrator gesperrt!</MudText>
        <MudImage Class="mt-6" Src="images/monkey_face_error.png" Width="256" Height="256"></MudImage>
    </div>
}

@code {
    [Parameter]
    public Identity User { get; set; } = default!;

    private readonly AccountOwnerPreferences accountOwnerSettings = new();

    private async Task CreateTenant()
    {
        await TenantManagement.CreateTenant(User!);

        Navigation.NavigateTo("/", true);
    }

    private async Task ActivateUser()
    {
        await TenantManagement.ActivateUser(User!, accountOwnerSettings);

        Navigation.NavigateTo("/", true);
    }

    private async Task AcceptInvitation()
    {
        await TenantManagement.AcceptInvitation(User!);

        Navigation.NavigateTo("/", true);
    }

    private async Task DeclineInvitation()
    {
        await TenantManagement.DeclineInvitation(User!);

        Navigation.NavigateTo("/", true);
    }
}
