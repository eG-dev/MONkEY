@using System.Text.Json

@if (_reportPayload != null)
{
    <MudText Typo="Typo.h4">@_reportPayload.AccountName</MudText>

    <MudText Class="mt-3" Typo="Typo.h5">Abschlussbilanz</MudText>
    <MudText Typo="Typo.h5">
        <Amount Value="@_reportPayload.ClosingBalance" Unit="€" IsBold="true" />
    </MudText>

    <MudText Class="mt-3" Typo="Typo.h6">Ausgangsbilanz</MudText>
    <MudText Typo="Typo.h6">
        <Amount Value="@_reportPayload.StartingBalance" Unit="€" />
    </MudText>

    <MudText Class="mt-3" Typo="Typo.h6">Transaktionen</MudText>
    @foreach (var transaction in _reportPayload.Transactions)
    {
        <MudText Typo="Typo.body2">
            @transaction.TriggeredOn - @transaction.TriggeredBy
        </MudText>
        <MudText Typo="Typo.body1">
            <Amount Value="@transaction.Amount" Unit="€" />
        </MudText>
        <MudText Typo="Typo.body2" GutterBottom="true">
            <i>@transaction.Comment</i>
        </MudText>
    }
}

@code {
    [Parameter]
    public Report Report { get; set; } = default!;

    private MonthlyReportPayload? _reportPayload = null;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (Report?.SerializedPayload != null)
        {
            _reportPayload = JsonSerializer.Deserialize<MonthlyReportPayload>(Report.SerializedPayload)!;
        }
        else
        {
            _reportPayload = null;
        }
    }
}
