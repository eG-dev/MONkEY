@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<div class="d-flex flex-column align-center">
    <MudImage Class="mb-6" Src="images/monkey_face_error.png" Width="256" Height="256"></MudImage>

    <MudText Color="Color.Error" Typo="Typo.h5">Oh nein, etwas ist schief gelaufen!</MudText>
    <MudText Typo="Typo.body1">Lade die Seite neu und probiere es erneut...</MudText>

    <div class="d-flex flex-column align-center mt-6 pb-3">
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.TwoTone.Refresh"
                   Style="min-width: 150px"
                   OnClick="Reload">
            Neu laden
        </MudButton>
    </div>

    @* @if (Env.IsDevelopment() && Error != null) *@
    @if (Error != null)
    {
        <MudAlert Class="mt-6" Style="word-break: break-all;" Severity="Severity.Error">
            @Error
        </MudAlert>
    }
</div>

@code {
    [Parameter]
    public Exception? Error { get; set; }

    private void Reload()
    {
        Navigation.NavigateTo(Navigation.Uri, true);
    }
}
