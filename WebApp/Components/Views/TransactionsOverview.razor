@using MONkEY.Data.Models
@using MONkEY.Data.Services

@inject TransactionService Transactions

<MudText Typo="Typo.h6">Letzte Transaktionen</MudText>
<MudTable @ref="_table" Items="@_transactions" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm" Loading="@_isLoading" LoadingProgressColor="Color.Info">
    <NoRecordsContent>
        Keine Transaktionen vorhanden...
    </NoRecordsContent>
    <HeaderContent>
        <MudTh>Betrag</MudTh>
        <MudTh>Datum</MudTh>
        <MudTh>Kommentar</MudTh>
        <MudTh>Auslöser</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Betrag"><Amount Value="@context.Amount" Unit="€" /></MudTd>
        <MudTd DataLabel="Datum" Class=""><LocalTime DateTime="@context.Timestamp!.Value.UtcDateTime" /></MudTd>
        <MudTd DataLabel="Kommentar">@context.Comment</MudTd>
        <MudTd DataLabel="Auslöser">@context.TriggedBy</MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter]
    public string Name { get; set; } = default!;

    private bool _isLoading = true;
    private MudTable<Transaction> _table = default!;

    private List<Transaction> _transactions = new();

    public async Task Refresh()
    {
        _transactions.Clear();

        if (_isLoading)
        {
            _isLoading = true;
            StateHasChanged();
        }

        if (!string.IsNullOrWhiteSpace(Name))
        {
            _transactions = await Transactions.GetAllAsync(Name, 25);
        }

        _isLoading = false;
        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        await Refresh();
    }

    private Func<Transaction, string> GetAmountCellStyle => x =>
    {
        string style = x.Amount < 0 ? "background: #F8D7DA" : "background: #D1E7DD";

        return style;
    };
}
