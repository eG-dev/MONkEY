@using MONkEY.Data
@using MONkEY.Data.Services

@inject ITransactionService Transactions

<MudText Typo="Typo.h6">Letzte Transaktionen</MudText>
<MudTable @ref="_table" Items="@_transactions" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm" Loading="@_isLoading" LoadingProgressColor="Color.Info">
    <NoRecordsContent>
        Keine Transaktionen vorhanden...
    </NoRecordsContent>
    <HeaderContent>
        <MudTh>Betrag</MudTh>
        <MudTh>Datum</MudTh>
        <MudTh>Kommentar</MudTh>
        <MudTh>Auslöser</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Betrag"><Amount Value="@context.Amount" Unit="€" /></MudTd>
        <MudTd DataLabel="Datum"><LocalTime DateTime="@context.TriggeredOn.UtcDateTime" /></MudTd>
        <MudTd DataLabel="Kommentar">@context.Comment</MudTd>
        <MudTd DataLabel="Auslöser">@context.TriggeredBy</MudTd>
    </RowTemplate>
</MudTable>

@if (!_isLoading && !_allTransactionsLoaded)
{
    <div class="d-flex justify-center py-3">
        <MudButton Variant="@Variant.Outlined" OnClick="() => LoadMore()">Mehr laden</MudButton>
    </div>
}

@code {
    private const int PAGE_SIZE = 10;

    [Parameter]
    public string Name { get; set; } = default!;

    private bool _isLoading = true;
    private MudTable<Transaction> _table = default!;

    private List<Transaction> _transactions = new();
    private bool _allTransactionsLoaded = false;

    protected async override Task OnInitializedAsync()
    {
        await Refresh();
    }

    public async Task Refresh()
    {
        var pageSize = Math.Max(_transactions.Count, PAGE_SIZE);

        _transactions.Clear();
        _allTransactionsLoaded = false;

        if (!_isLoading)
        {
            _isLoading = true;
            StateHasChanged();
        }

        if (!string.IsNullOrWhiteSpace(Name))
        {
            _transactions = await Transactions.GetAsync(Name, pageSize);
        }

        _allTransactionsLoaded = _transactions.Count < pageSize;

        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadMore()
    {
        if (!_isLoading && !_allTransactionsLoaded)
        {
            _isLoading = true;
            StateHasChanged();

            var lastTransaction = _transactions.Last();

            var olderTransactions = await Transactions.GetAsync(Name, PAGE_SIZE, lastTransaction.TriggeredOn);
            _transactions.AddRange(olderTransactions);

            _allTransactionsLoaded = olderTransactions.Count < PAGE_SIZE;

            _isLoading = false;
            StateHasChanged();
        }
    }

    private Func<Transaction, string> GetAmountCellStyle => x =>
    {
        string style = x.Amount < 0 ? "background: #F8D7DA" : "background: #D1E7DD";

        return style;
    };
}
