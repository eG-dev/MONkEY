@using WebApp.Models
@using WebApp.Services

@inject TransactionService Transactions

@if (_isLoading)
{
    <PageLoader />
}
else
{
    <h3>Letzte Transaktionen</h3>
    <Grid @ref="_grid"
          TItem="Transaction"
          Class="table table-hover table-bordered table-striped"
          EmptyText="Keine Transaktionen vorhanden.."
          DataProvider="TransactionsDataProvider"
          Responsive="true">

        <GridColumns>
            <GridColumn TItem="Transaction" HeaderText="Datum" PropertyName="Timestamp">
                <LocalTime DateTime="@context.Timestamp!.Value.UtcDateTime" />
            </GridColumn>
            <GridColumn TItem="Transaction" HeaderText="Betrag" PropertyName="Amount" ColumnClass="@(e => e.Amount > 0 ? "table-success" : "table-danger")">
                @context.Amount.ToString("+0;-#")€
            </GridColumn>
            <GridColumn TItem="Transaction" HeaderText="Ausgelöst durch" PropertyName="TriggedBy">
                @context.TriggedBy
            </GridColumn>
        </GridColumns>
    </Grid>
}

@code {
    [Parameter]
    public string Name { get; set; } = default!;

    private bool _isLoading = true;

    private Grid<Transaction> _grid = default!;
    private List<Transaction> _transactions = new();

    public async Task Refresh()
    {
        _isLoading = true;

        StateHasChanged();

        await Load();

        StateHasChanged();
    }

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(Name))
        {
            _transactions = await Transactions.GetAllAsync(Name, 25);
        }

        _isLoading = false;
    }

    private async Task<GridDataProviderResult<Transaction>> TransactionsDataProvider(GridDataProviderRequest<Transaction> request)
    {
        return await Task.FromResult(request.ApplyTo(_transactions));
    }
}
