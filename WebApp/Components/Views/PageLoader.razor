@if (IsActive)
{
    if (AsOverlay)
    {
        <MudOverlay Class="page-loader" Visible="true" DarkBackground="true">
            <MudProgressCircular Color="@IndicatorColor" Size="Size.Large" Indeterminate="true" />
        </MudOverlay>
    }
    else
    {
        <div class="page-loader page-content d-flex justify-center align-center">
            <MudProgressCircular Color="@IndicatorColor" Size="Size.Large" Indeterminate="true" />
        </div>
    }
}

@code {
    private bool _isActive = true;

    [Parameter]
    public bool IsActive { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsActiveChanged { get; set; }

    [Parameter]
    public bool AsOverlay { get; set; } = false;

    [Parameter]
    public Color IndicatorColor { get; set; } = Color.Primary;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (_isActive != IsActive)
        {
            _isActive = IsActive;

            if (IsActiveChanged.HasDelegate)
            {
                IsActiveChanged.InvokeAsync(_isActive);
            }
        }
    }
}
