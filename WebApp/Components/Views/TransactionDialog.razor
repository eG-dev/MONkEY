@using WebApp.Models

<MudDialog>
    <DialogContent>
        <MudFocusTrap>
            <MudNumericField @bind-Value="_model.Amount"
                Label="Betrag" Variant="Variant.Text"
                Min="1" Max="1000" Step="1"
                Immediate="true"
                Adornment="Adornment.Start" AdornmentIcon="@(PayOut ? Icons.Material.Filled.Remove : Icons.Material.Filled.Add)" AdornmentColor="@(PayOut ? Color.Error : Color.Success)" />
        </MudFocusTrap>

        <MudTextField T="string" Label="Kommentar" Variant="Variant.Outlined" @bind-Text="@_model.Comment" Lines="3" MaxLength="100" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Okay</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public bool PayOut { get; set; } = false;

    private TransactionDialogModel _model = new();

    private void Submit()
    {
        _model.Amount = _model.Amount ?? 0.0;

        if (PayOut)
        {
            _model.Amount = 0 - _model.Amount;
        }

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}