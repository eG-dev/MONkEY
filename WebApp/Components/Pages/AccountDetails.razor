@page "/accountDetails/{Name:alpha}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Models
@using WebApp.Services

@inject AccountService Accounts
@inject TransactionService Transactions
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>MONkEY App - Kontodetails</PageTitle>

<div>
    <Breadcrumb style="--bs-breadcrumb-divider: '>';" Items="_breadcrumbs"></Breadcrumb>
</div>

@if (_isLoading)
{
    <PageLoader />
}
else if (_account != null)
{
    <Toasts class="p-3" Messages="_messages" AutoHide="true" StackLength="3" Placement="ToastsPlacement.TopRight" />

    <h3>@_account.Name</h3>

    <Button Color="ButtonColor.Success" Type="ButtonType.Button" @onclick="() => UpdateBalance(50.0)">+50€</Button>
    <Button Color="ButtonColor.Danger" Type="ButtonType.Button" @onclick="() => UpdateBalance(-10.0)">-10€</Button>

    <br />
    <br />
    <TransactionsOverview Name="@_account.Name" />
}
else
{
    <Alert Color="AlertColor.Danger"> <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>Das Konto ist nicht bekannt! </Alert>
}

@code {
    [Parameter]
    public string Name { get; set; } = default!;

    private List<BreadcrumbItem> _breadcrumbs { get; set; } = new()
    {
        new BreadcrumbItem { Text = "Übersicht", Href ="/" }
    };

    private List<ToastMessage> _messages = new ();

    private bool _isLoading = true;
    private Account? _account = null;


    protected async override Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Name))
        {
            _breadcrumbs.Add(new BreadcrumbItem { Text = Name, IsCurrentPage = true });

            _account = await Accounts.GetAsync(Name);
        }

        _isLoading = false;
    }

    public async Task UpdateBalance(double amount)
    {
        var account = await Accounts.GetAsync(Name);
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (account != null && authState?.User?.Identity != null)
        {
            await Transactions.InsertAsync(new Transaction()
                {
                    Recipient = account!.Name,
                    TriggedBy = authState.User!.Identity!.Name!,
                    Amount = amount,
                });

            account.Balance += amount;

            await Accounts.UpdateAsync(account);

            _messages.Add(new ToastMessage()
                {
                    Type = amount < 0 ? ToastType.Danger : ToastType.Success,
                    Message = amount < 0 ? $"{Math.Abs(amount)}€ vom Guthaben abgezogen..." : $"{Math.Abs(amount)}€ zum Guthaben hinzugefügt...",
                });
        }
    }
}
