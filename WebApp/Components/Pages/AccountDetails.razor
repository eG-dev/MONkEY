@page "/{Tenant}/account/{AccountKey}"

@using Microsoft.AspNetCore.Components.Authorization

@using MONkEY.WebApp.DTO
@using MONkEY.Data
@using MONkEY.Data.Services

@inject NavigationManager Navigation
@inject AccountManagementService AccountManagement
@inject IAccountService Accounts
@inject ITransactionService Transactions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>MONkEY App - Kontodetails</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">"></MudBreadcrumbs>
</div>

@if (_account != null)
{
    var accountImageSrc = !string.IsNullOrEmpty(_account.Image)
        ? $"api/image/{_account.TenantKey}/{_account.Image}"
        : "images/monkey_face.png";

    <div class="d-flex gap-6 justify-start align-center">
        <MudAvatar>
            <MudImage Src="@accountImageSrc"></MudImage>
        </MudAvatar>
        <MudText Typo="Typo.h3">@_account.Name</MudText>
        <div class="flex-grow-1" />
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="() => GotoAccountEdit()" />
    </div>
    <MudText Typo="Typo.subtitle1">Aktuelles Guthaben beträgt @_account.Balance€.</MudText>
    @if (_account.PocketMoney.GetValueOrDefault() > 0)
    {
        <MudText Typo="Typo.subtitle2">@_account.Name bekommt monatlich @_account.PocketMoney€ Taschengeld.</MudText>
    }
    else
    {
        <MudText Typo="Typo.subtitle2">@_account.Name bekommt kein Taschengeld.</MudText>
    }

    <br />
    <br />
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               StartIcon="@Icons.Material.TwoTone.Add"
               style="min-width: 150px"
               OnClick="() => InitiateTransaction(false)">
                Einzahlen
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               StartIcon="@Icons.Material.TwoTone.Remove"
               style="min-width: 150px"
               OnClick="() => InitiateTransaction(true)">
               Auszahlen
    </MudButton>
    <br />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.TwoTone.Wallet"
               class="mt-2"
               style="min-width: 304px"
               OnClick="InitiatePocketMoneyAdjustment">
               Taschengeld festlegen
    </MudButton>
    <br />
    <br />
    <TransactionsOverview @ref="_transactionsOverview" Tenant="@_account.TenantKey" AccountKey="@_account.AccountKey" />

    <MudOverlay @bind-Visible="_isUpdating" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
}
else if (_isLoading)
{
    <PageLoader />
}
else
{
    <MudAlert Severity="Severity.Error">Das Konto ist nicht bekannt!</MudAlert>
}

@code {
    [Parameter]
    public string Tenant { get; set; } = default!;

    [Parameter]
    public string AccountKey { get; set; } = default!;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Übersicht", "/", false, Icons.Material.TwoTone.Home)
    };

    private bool _isLoading = true;
    private bool _isUpdating = false;

    private Account? _account = null;

    private TransactionsOverview _transactionsOverview = default!;

    protected async override Task OnInitializedAsync()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(Tenant) && !string.IsNullOrWhiteSpace(AccountKey))
        {
            _account = await Accounts.GetAsync(Tenant, AccountKey);

            if (_account != null)
            {
                _breadcrumbs.Add(new BreadcrumbItem(
                    _account.Name,
                    $"/{_account.TenantKey}/account/{_account.AccountKey}",
                    false,
                    Icons.Material.TwoTone.Wallet));
            }
        }

        _isLoading = false;
    }

    private void GotoAccountEdit()
    {
        Navigation.NavigateTo($"{_account!.TenantKey}/account/{_account.AccountKey}/edit");
    }

    private async Task InitiateTransaction(bool payOut)
    {
        var dialog = await Dialog.ShowAsync<TransactionDialog>(
            payOut ? "Guthaben auszahlen" : "Guthaben einzahlen",
            new DialogParameters<TransactionDialog>
            {
                { x => x.PayOut, payOut },
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Small,
            });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is TransactionDialogModel model)
        {
            if (model.Amount.HasValue &&
                !double.IsNaN(model.Amount.Value) &&
                model.Amount != 0)
            {
                await UpdateBalance(model.Amount.Value, model.Comment);
            }
        }
    }

    private async Task InitiatePocketMoneyAdjustment()
    {
        var dialog = await Dialog.ShowAsync<PocketMoneyDialog>(
            "Taschengeld festlegen",
            new DialogParameters<PocketMoneyDialog>
            {
                { x => x.PocketMoney, _account!.PocketMoney },
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Small,
            });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PocketMoneyDialogModel model)
        {
            if (model.PocketMoney.HasValue &&
                !double.IsNaN(model.PocketMoney.Value) &&
                model.PocketMoney >= 0)
            {
                await AdjustPocketMoney(model.PocketMoney.Value);
            }
        }
    }

    private async Task InitiateProfileImageUpdate()
    {
        string imageSrc = string.Empty;
        if (!string.IsNullOrEmpty(_account!.Image))
        {
            imageSrc = $"api/image/{_account.TenantKey}/{_account.Image}";
        }

        var dialog = await Dialog.ShowAsync<ImageSelectionDialog>(
            "Profilbild ändern",
            new DialogParameters<ImageSelectionDialog>()
            {
                { x => x.Src, imageSrc }
            },
            new DialogOptions()
            {
                FullScreen = true,
                Position = DialogPosition.Custom,
            });

        var result = await dialog.Result;

        if (result != null &&
            !result.Canceled && result.Data is ImageSelectionDialogModel model &&
            !string.IsNullOrEmpty(model.ImageDataBase64))
        {
            _isUpdating = true;
            StateHasChanged();

            try
            {
                _account = await AccountManagement.UpdateProfileImage(_account.TenantKey, _account.AccountKey, model.ImageDataBase64);
            }
            catch { }
            finally
            {
                _isUpdating = false;
                StateHasChanged();
            }
        }
    }

    private async Task UpdateBalance(double amount, string? comment)
    {
        _isUpdating = true;
        StateHasChanged();

        try
        {
            var account = await Accounts.GetAsync(_account!.TenantKey, _account.AccountKey);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (account != null && authState?.User?.Identity != null)
            {
                string? userName = authState.User.FindFirst("name")?.Value;
                string userEmail = authState.User.Identity.Name!;

                await Transactions.AddAsync(new Transaction()
                    {
                        PartitionKey = account.TenantKey,
                        AccountKey = account.AccountKey,
                        TriggeredBy = !string.IsNullOrEmpty(userName) ? $"{userName} ({userEmail})" : userEmail,
                        Amount = amount,
                        Comment = comment,
                    });

                account.Balance += amount;

                await Accounts.UpdateAsync(account);

                _account = account;

                Snackbar.Add(amount < 0 ? $"{Math.Abs(amount)}€ vom Guthaben abgezogen" : $"{Math.Abs(amount)}€ zum Guthaben hinzugefügt", Severity.Success);
            }
        }
        catch {}
        finally
        {
            _isUpdating = false;
            StateHasChanged();

            if (_transactionsOverview != null)
            {
                await _transactionsOverview.Refresh();
            }
        }
    }

    private async Task AdjustPocketMoney(double pocketMoney)
    {
        _isUpdating = true;
        StateHasChanged();

        try
        {
            var account = await Accounts.GetAsync(_account!.TenantKey, _account.AccountKey);

            if (account != null)
            {
                account.PocketMoney = pocketMoney;

                await Accounts.UpdateAsync(account);

                _account = account;

                if (pocketMoney == 0)
                {
                    Snackbar.Add($"{_account.Name} bekommt zukünftig kein Taschengeld!", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"{_account.Name} bekommt zukünftig {pocketMoney}€ Taschengeld im Monat!", Severity.Success);
                }
            }
        }
        catch {}
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }
}
