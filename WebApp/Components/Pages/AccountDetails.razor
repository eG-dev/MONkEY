@page "/account/{TenantKey}/{AccountKey}"

@using Microsoft.AspNetCore.Components.Authorization

@using MONkEY.WebApp.DTO
@using MONkEY.Data
@using MONkEY.Data.Services

@inject NavigationManager Navigation
@inject AccountManagementService AccountManagement
@inject IAccountService Accounts
@inject ITransactionService Transactions
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>MONkEY App - Kontodetails</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">"></MudBreadcrumbs>
</div>

@if (_account != null)
{
    var accountImageSrc = AccountManagement.GetAccountImageSrc(_account);

    <div class="d-flex gap-6 justify-start align-center">
        <MudAvatar>
            <MudImage Src="@accountImageSrc"></MudImage>
        </MudAvatar>
        <AccountName Text="@_account.Name" />
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="() => GotoAccountEdit()" />
    </div>

    <MudText Class="mt-6" Typo="Typo.subtitle1">Aktuelles Guthaben</MudText>
    <MudText Typo="Typo.h4"><Amount Value="@_account.Balance" Unit="€" IsBold="true" /></MudText>

    <div class="mt-3">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.TwoTone.Add"
                   Style="min-width: 150px"
                   OnClick="() => InitiateTransaction(false)">
            Einzahlen
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.TwoTone.Remove"
                   Style="min-width: 150px"
                   OnClick="() => InitiateTransaction(true)">
            Auszahlen
        </MudButton>
        <br />
    </div>
    
    <div class="mt-6">
        @if (_account.PocketMoney.GetValueOrDefault() > 0)
        {
            <MudText Typo="Typo.subtitle1">@_account.Name bekommt monatlich <Amount Value="@_account.PocketMoney" Unit="€" IsBold="true" /> Taschengeld.</MudText>
        }
        else
        {
            <MudText Typo="Typo.subtitle1">@_account.Name bekommt <b>kein</b> Taschengeld.</MudText>
        }
        @if (_pocketMoneyTransaction != null)
        {
            <MudText Typo="Typo.subtitle2">
                Das Taschengeld wurde in diesem Monat am
                <LocalTime DateTime="@_pocketMoneyTransaction.TriggeredOn.UtcDateTime" Format="d" />
                gutgeschrieben.
            </MudText>
        }
    </div>

    <div class="mt-3">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.TwoTone.Wallet"
                   Class="mt-2"
                   Style="min-width: 304px"
                   OnClick="InitiatePocketMoneyAdjustment">
            Taschengeld festlegen
        </MudButton>
    </div>

    <TransactionsOverview Class="mt-6" @ref="_transactionsOverview" TenantKey="@_account.TenantKey" AccountKey="@_account.AccountKey" />

    <MudOverlay @bind-Visible="_isUpdating" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
}
else if (_isLoading)
{
    <PageLoader />
}
else
{
    <MudAlert Severity="Severity.Error">Das Konto ist nicht bekannt!</MudAlert>
}

@code {
    [CascadingParameter]
    private Identity User { get; set; } = default!;

    [Parameter]
    public string TenantKey { get; set; } = default!;

    [Parameter]
    public string AccountKey { get; set; } = default!;

    private const string POCKET_MONEY_TRANSACTION_TRIGGER_NAME = "Taschengeld-Service";

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Übersicht", "/", false, Icons.Material.TwoTone.Home)
    };

    private bool _isLoading = true;
    private bool _isUpdating = false;

    private Account? _account = null;
    private Transaction? _pocketMoneyTransaction = null;

    private TransactionsOverview _transactionsOverview = default!;

    protected async override Task OnInitializedAsync()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(TenantKey) && !string.IsNullOrWhiteSpace(AccountKey))
        {
            _account = await Accounts.GetAsync(TenantKey, AccountKey);

            if (_account != null)
            {
                _breadcrumbs.Add(new BreadcrumbItem(
                    _account.Name,
                    $"/account/{_account.TenantKey}/{_account.AccountKey}",
                    false,
                    Icons.Material.TwoTone.Wallet));

                var transactions = await Transactions.GetSinceAsync(
                    _account.TenantKey,
                    _account.AccountKey,
                    DateTimeOffset.UtcNow.StartOfMonth(),
                    POCKET_MONEY_TRANSACTION_TRIGGER_NAME);
                _pocketMoneyTransaction = transactions.FirstOrDefault();
            }
        }

        _isLoading = false;
    }

    private void GotoAccountEdit()
    {
        Navigation.NavigateTo($"/account/{_account!.TenantKey}/{_account.AccountKey}/edit");
    }

    private async Task InitiateTransaction(bool payOut)
    {
        var dialog = await Dialog.ShowAsync<TransactionDialog>(
            payOut ? "Guthaben auszahlen" : "Guthaben einzahlen",
            new DialogParameters<TransactionDialog>
            {
                { x => x.PayOut, payOut },
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Small,
            });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is TransactionDialogModel model)
        {
            if (model.Amount.HasValue &&
                !double.IsNaN(model.Amount.Value) &&
                model.Amount != 0)
            {
                await UpdateBalance(model.Amount.Value, model.Comment);
            }
        }
    }

    private async Task InitiatePocketMoneyAdjustment()
    {
        var dialog = await Dialog.ShowAsync<PocketMoneyDialog>(
            "Taschengeld festlegen",
            new DialogParameters<PocketMoneyDialog>
            {
                { x => x.PocketMoney, _account!.PocketMoney },
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Small,
            });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PocketMoneyDialogModel model)
        {
            if (model.PocketMoney.HasValue &&
                !double.IsNaN(model.PocketMoney.Value) &&
                model.PocketMoney >= 0)
            {
                await AdjustPocketMoney(model.PocketMoney.Value);
            }
        }
    }

    private async Task UpdateBalance(double amount, string? comment)
    {
        if (User == null || !User.IsKnown)
        {
            return;
        }

        _isUpdating = true;
        StateHasChanged();

        try
        {
            var account = await Accounts.GetAsync(_account!.TenantKey, _account.AccountKey);

            if (account != null)
            {
                await Transactions.AddAsync(new Transaction()
                    {
                        PartitionKey = account.TenantKey,
                        AccountKey = account.AccountKey,
                        TriggeredBy = !string.IsNullOrEmpty(User.Name) ? $"{User.Name} ({User.Email})" : User.Email,
                        Amount = amount,
                        Comment = comment,
                    });

                account.Balance += amount;

                await Accounts.UpdateAsync(account);

                _account = account;

                Snackbar.Add(amount < 0 ? $"{Math.Abs(amount)}€ vom Guthaben abgezogen" : $"{Math.Abs(amount)}€ zum Guthaben hinzugefügt", Severity.Success);
            }
        }
        catch {}
        finally
        {
            _isUpdating = false;
            StateHasChanged();

            if (_transactionsOverview != null)
            {
                await _transactionsOverview.Refresh();
            }
        }
    }

    private async Task AdjustPocketMoney(double pocketMoney)
    {
        _isUpdating = true;
        StateHasChanged();

        try
        {
            var account = await Accounts.GetAsync(_account!.TenantKey, _account.AccountKey);

            if (account != null)
            {
                account.PocketMoney = pocketMoney;

                await Accounts.UpdateAsync(account);

                _account = account;

                if (pocketMoney == 0)
                {
                    Snackbar.Add($"{_account.Name} bekommt zukünftig kein Taschengeld!", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"{_account.Name} bekommt zukünftig {pocketMoney}€ Taschengeld im Monat!", Severity.Success);
                }
            }
        }
        catch {}
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }
}
