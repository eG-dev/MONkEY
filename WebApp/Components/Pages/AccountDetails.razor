@page "/accountDetails/{Name:alpha}"

@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Models
@using WebApp.Services

@inject AccountService Accounts
@inject TransactionService Transactions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>MONkEY App - Kontodetails</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">"></MudBreadcrumbs>
</div>

@if (_account != null)
{
    <MudText Typo="Typo.h1">@_account.Name</MudText>
    <MudText Typo="Typo.h4">Aktuelles Guthaben beträgt @_account.Balance Euro</MudText>

    <br />
    <br />
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="() => UpdateBalance(50.0)">+50€</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => UpdateBalance(-10.0)">-10€</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenDialogAsync()">Dialog Test</MudButton>

    <br />
    <br />
    <TransactionsOverview @ref="_transactionsOverview" Name="@_account.Name" />
}
else
{
    <MudAlert Severity="Severity.Error">Das Konto ist nicht bekannt!</MudAlert>
}

@code {
    [Parameter]
    public string Name { get; set; } = default!;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Übersicht", "/", false, Icons.Material.Filled.Home)
    };

    private Account? _account = null;

    private TransactionsOverview _transactionsOverview = default!;

    protected async override Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Name))
        {
            _account = await Accounts.GetAsync(Name);

            _breadcrumbs.Add(new BreadcrumbItem(Name, $"/accountDetails/{Name}", false, Icons.Material.Filled.Wallet));
        }
    }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        await Dialog.ShowAsync<TransactionDialog>("Simple Dialog", options);
    }

    public async Task UpdateBalance(double amount)
    {
        try
        {
            var account = await Accounts.GetAsync(Name);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (account != null && authState?.User?.Identity != null)
            {
                await Transactions.InsertAsync(new Transaction()
                    {
                        Recipient = account!.Name,
                        TriggedBy = authState.User!.Identity!.Name!,
                        Amount = amount,
                    });

                account.Balance += amount;

                await Accounts.UpdateAsync(account);

                Snackbar.Add(amount < 0 ? $"{Math.Abs(amount)}€ vom Guthaben abgezogen" : $"{Math.Abs(amount)}€ zum Guthaben hinzugefügt", Severity.Success);
            }
        }
        catch (Exception e)
        {
            throw e;
        }
        finally
        {
            if (_transactionsOverview != null)
            {
                await _transactionsOverview.Refresh();
            }
        }
    }
}
