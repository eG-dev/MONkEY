@page "/"

@using System.Security.Principal
@using System.Globalization

@using MONkEY.Data
@using MONkEY.Data.Services

@inject IAccountService Accounts
@inject ITransactionService Transactions
@inject NavigationManager Navigation

<PageTitle>MONkEY App</PageTitle>

@if (_isLoading)
{
    <PageLoader />
}
else if (_accounts != null)
{
    <div class="d-flex flex-grow-1 flex-wrap gap-4 pa-4">
        @foreach (var account in _accounts)
        {
            var transaction = _lastTransactions[account.Name];

            var accountImageSrc = !string.IsNullOrEmpty(account.ProfileImageBig)
                ? $"api/image/{account.TenantId}/{account.ProfileImageBig}"
                : "images/monkey_face.png";

            <MudCard Class="flex-auto d-flex" Elevation="5">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary">@account.Name.Substring(0, 1).ToUpper()</MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5">@account.Name</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardMedia Image="@accountImageSrc" Class="cursor-pointer" @onclick="() => ShowAccountDetails(account.Name)" />
                <MudCardContent>
                    <MudText Typo="Typo.body1">Aktuelles Guthaben: @account.Balance€</MudText>
                    @if (transaction != null)
                    {
                        <MudText Typo="Typo.caption">Letzte Transaktion am <LocalTime DateTime="@transaction.Timestamp!.Value.UtcDateTime" Format="g" /></MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">Keine Transaktionen vorhanden</MudText>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => ShowAccountDetails(account.Name)">Auswählen</MudButton>
                </MudCardActions>
            </MudCard>
        }
    </div>
}

@code {
    private bool _isLoading = true;

    private readonly Dictionary<string, Transaction?> _lastTransactions = new();

    private List<Account>? _accounts;

    protected async override Task OnInitializedAsync()
    {
        _accounts = await Accounts.GetAllAsync();

        foreach (var account in _accounts)
        {
            _lastTransactions[account.Name] = await Transactions.GetLatestAsync(account.Name);
        }

        _isLoading = false;
    }

    private void ShowAccountDetails(string accountName)
    {
        Navigation.NavigateTo($"/accountDetails/{accountName}");
    }
}
