@page "/"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Principal
@using System.Globalization

@inject IAccountManagementService AccountManagement
@inject IAccountService Accounts
@inject ITransactionService Transactions
@inject NavigationManager Navigation
@inject IDialogService Dialog

<PageTitle>POCKET MONkEY</PageTitle>

@if (_accounts == null)
{
    <PageLoader />
}
else if (User.Status == AccountOwnerStatus.Active)
{
    <MudGrid Spacing="6" Justify="Justify.Center">
        @foreach (var account in _accounts)
        {
            _lastTransactions.TryGetValue(account.AccountKey, out Transaction? transaction);

            var accountImageSrc = AccountManagement.GetImageSrc(account);

            var accountDetailsAction = () => GotoAccountDetails(account.AccountKey);
            var accountEditAction = () => GotoAccountEdit(account.AccountKey);

            <MudItem xs="12" sm="6" xl="4">
                <MudCard Class="flex-auto d-flex" Elevation="5">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary" Class="cursor-pointer" @onclick="accountDetailsAction">
                                @account.Name.Substring(0, 1).ToUpper()
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="@(account.Name.Length > 16 ? Typo.h6 : Typo.h5)" Class="cursor-pointer" @onclick="accountDetailsAction">
                                @account.Name
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (User.IsAllowedToManage)
                            {
                                <MudIconButton Icon="@Icons.Material.TwoTone.Edit"
                                               Color="Color.Default"
                                               OnClick="accountEditAction" />
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardMedia Image="@accountImageSrc"
                                  Class="cursor-pointer"
                                  @onclick="accountDetailsAction" />
                    <MudCardContent>
                        <MudText Typo="Typo.body1">
                            Aktuelles Guthaben <Amount Value="@account.Balance" Unit="€" IsBold="true" />
                        </MudText>

                        @if (transaction != null)
                        {
                            <MudText Typo="Typo.caption">
                                Letzte Transaktion am <LocalTime DateTime="@transaction.Timestamp!.Value.UtcDateTime" Format="g" />
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">Keine Transaktionen vorhanden</MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="accountDetailsAction">
                            Auswählen
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (_accounts.Count == 0)
    {
        <div class="d-flex flex-column align-center mt-6">
            <MudText Typo="Typo.h5">Es ist ganz schön leer hier...</MudText>
            <MudImage Class="my-6" Src="images/monkey_face.png" Width="256" Height="256"></MudImage>
            
            @if (User.IsAllowedToManage)
            {
                <MudText Typo="Typo.body1">Wir sollten als allererstes ein neues Konto hinzufügen.</MudText>
            }
        </div>
    }

    if (_accounts.Count < 9 && User.IsAllowedToManage)
    {
        <div class="d-flex flex-column align-center mt-6">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.TwoTone.Add"
                       Style="min-width: 150px"
                       OnClick="AddAccount">
                Konto hinzufügen
            </MudButton>
        </div>
    }
}

@code {
    [CascadingParameter]
    private User User { get; set; } = default!;

    private readonly Dictionary<string, Transaction?> _lastTransactions = new();

    private List<Account>? _accounts = null;

    protected override async Task OnInitializedAsync()
    {
        if (User?.Status == AccountOwnerStatus.Active)
        {
            _accounts = await Accounts.GetAllAsync(User.TenantKey);

            foreach (var account in _accounts)
            {
                _lastTransactions[account.AccountKey] = await Transactions.GetLatestAsync(User.TenantKey, account.AccountKey);
            }
        }
        else
        {
            _accounts = new();
        };
    }

    private async Task AddAccount()
    {
        var dialog = await Dialog.ShowAsync<AccountCreationDialog>(
            "Im Dutzend billiger?",
            new DialogParameters<AccountCreationDialog>(),
            new DialogOptions()
                {
                    MaxWidth = MaxWidth.Small,
                });

        var result = await dialog.Result;

        if (result?.Data != null && result.Data is string accountName)
        {
            var account = await AccountManagement.Create(User, accountName);

            if (account != null)
            {
                Navigation.NavigateTo($"/account/{User.TenantKey}/{account.AccountKey}/edit");
            }
        }
    }

    private void GotoAccountDetails(string accountKey)
    {
        Navigation.NavigateTo($"/account/{User.TenantKey}/{accountKey}");
    }

    private void GotoAccountEdit(string accountKey)
    {
        Navigation.NavigateTo($"/account/{User.TenantKey}/{accountKey}/edit");
    }
}
