@page "/"
@rendermode InteractiveServer

@using System.Security.Principal
@using System.Globalization
@using WebApp.Models
@using WebApp.Services

@inject AccountService Accounts
@inject TransactionService Transactions
@inject NavigationManager Navigation

<InitializeTimeZone />

<PageTitle>MONkEY App</PageTitle>

@if (_accounts != null)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var account in _accounts)
        {
            var transaction = _lastTransactions[account.Name];

            <div class="col">
                <Card>
                    <img src="@($"images/{account.Name.ToLower()}.png")" class="card-img-top account-image" alt="Image @account.Name" @onclick="() => ShowAccountDetails(account.Name)">
                    <CardBody>
                        <CardTitle>@account.Name</CardTitle>
                        <CardText>Aktuelles Guthaben: @account.Balance€</CardText>
                        <Button Color="ButtonColor.Primary" Type="ButtonType.Button" @onclick="() => ShowAccountDetails(account.Name)">Auswählen</Button>
                    </CardBody>
                    <CardFooter>
                        @if (transaction != null)
                        {
                            <small class="text-muted">Letzte Transaktion am <LocalTime DateTime="@transaction.Timestamp!.Value.UtcDateTime" /></small>
                        }
                        else
                        {
                            <small class="text-muted">Keine Transaktionen vorhanden</small>
                        }
                    </CardFooter>
                </Card>
            </div>
        }
    </div>
}

@code {
    [Inject]
    protected PreloadService Busy { get; set; } = default!;

    private List<Account>? _accounts;
    private Dictionary<string, Transaction?> _lastTransactions = new();

    protected async override Task OnInitializedAsync()
    {
        Busy.Show(SpinnerColor.Dark);

        try
        {
            _accounts = await Accounts.GetAllAsync();

            foreach (var account in _accounts)
            {
                _lastTransactions[account.Name] = await Transactions.GetLatestAsync(account.Name);
            }
        }
        catch (Exception e)
        {
            throw e;
        }
        finally
        {
            Busy.Hide();
        }
    }

    private void ShowAccountDetails(string accountName)
    {
        Navigation.NavigateTo($"/accountDetails/{accountName}");
    }
}
