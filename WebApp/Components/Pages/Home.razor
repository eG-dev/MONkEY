@page "/"

@using System.Security.Principal
@using System.Globalization
@using WebApp.Models
@using WebApp.Services

@inject AccountService Accounts
@inject TransactionService Transactions

<PageTitle>MONkEY App</PageTitle>

@if (_accounts == null)
{
    <PageLoader />
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var account in _accounts)
        {
            var transaction = _lastTransactions[account.Name];

            <div class="col">
                <Card>
                    <img src="@($"images/{account.Name.ToLower()}.png")" class="card-img-top" alt="Image @account.Name">
                    <CardBody>
                        <CardTitle>@account.Name</CardTitle>
                        <CardText>Aktuelles Guthaben: @account.Balance€</CardText>
                        <Button Color="ButtonColor.Primary" To="@($"/accountDetails/{account.Name}")" Type="ButtonType.Link">Auswählen</Button>
                    </CardBody>
                    <CardFooter>
                        @if (transaction != null)
                        {
                            var text = @transaction.Timestamp.GetValueOrDefault().ToString("F");

                            <small class="text-muted">Letzte Transaktion am @text</small>
                        }
                        else
                        {
                            var text = @account.Timestamp.GetValueOrDefault().ToString("F");

                            <small class="text-muted">Letzte Aktualisierung am @text</small>
                        }
                    </CardFooter>
                </Card>
            </div>
        }
    </div>
}

@code {
    private List<Account>? _accounts;
    private Dictionary<string, Transaction?> _lastTransactions = new();

    protected async override Task OnInitializedAsync()
    {
        _accounts = await Accounts.GetAllAsync();

        foreach (var account in _accounts)
        {
            _lastTransactions[account.Name] = await Transactions.GetLatestAsync(account.Name);
        }
    }
}
