@page "/"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Principal
@using System.Globalization

@using MONkEY.Data
@using MONkEY.Data.Services

@inject IAccountOwnerService AccountOwners
@inject AccountManagementService AccountManagement
@inject IAccountService Accounts
@inject ITransactionService Transactions
@inject NavigationManager Navigation
@inject IDialogService Dialog

<PageTitle>MONkEY App</PageTitle>

@if (_isLoading)
{
    <PageLoader />
}
else if (User?.IsEnabled == true)
{
    <MudGrid Spacing="6" Justify="Justify.Center">
        @foreach (var account in _accounts)
        {
            _lastTransactions.TryGetValue(account.AccountKey, out Transaction? transaction);

            var accountImageSrc = AccountManagement.GetAccountImageSrc(account);

            <MudItem xs="12" sm="6" xl="4">
                <MudCard Class="flex-auto d-flex" Elevation="5">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary">@account.Name.Substring(0, 1).ToUpper()</MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="@(account.Name.Length > 16 ? Typo.h6 : Typo.h5)">@account.Name</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="() => GotoAccountEdit(account.AccountKey)" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardMedia Image="@accountImageSrc"
                                  Class="cursor-pointer"
                                  @onclick="() => GotoAccountDetails(account.AccountKey)" />
                    <MudCardContent>
                        <MudText Typo="Typo.body1">Aktuelles Guthaben <Amount Value="@account.Balance" Unit="€" IsBold="true" /></MudText>
                        @if (transaction != null)
                        {
                            <MudText Typo="Typo.caption">Letzte Transaktion am <LocalTime DateTime="@transaction.Timestamp!.Value.UtcDateTime" Format="g" /></MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">Keine Transaktionen vorhanden</MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="() => GotoAccountDetails(account.AccountKey)">
                            Auswählen
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (_accounts.Count == 0)
    {
        <div class="d-flex flex-column align-center mt-6">
            <MudText Typo="Typo.h5">Es ist ganz schön leer hier...</MudText>
            <MudImage Class="my-6" Src="images/monkey_face.png" Width="256" Height="256"></MudImage>
            <MudText Typo="Typo.body1">Wir sollten als allererstes ein neues Konto hinzufügen.</MudText>
        </div>
    }
    
    if (_accounts.Count < 9)
    {
        <div class="d-flex flex-column align-center mt-6 pb-3">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Style="min-width: 150px"
                       OnClick="AddAccount">
                Konto hinzufügen
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Error"
                       Style="min-width: 150px"
                       OnClick="ThrowTestError">
                Fehler provozieren
            </MudButton>
        </div>
    }
}
else
{
    if (_accountOwner?.Status == AccountOwnerStatus.Pending)
    {
        <div class="d-flex flex-column align-center mt-6">
            <MudText Typo="Typo.h5">Dein Nutzer wartet auf die Freischaltung!</MudText>
            <MudImage Class="my-6" Src="images/monkey_face.png" Width="256" Height="256"></MudImage>
            <MudAlert Severity="Severity.Info">
                Bitte schau zu einem späteren Zeitpunkt wieder vorbei oder wende Dich an den Administrator.
            </MudAlert>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-center mt-6">
            <MudText Typo="Typo.h5">Du hast noch keinen eigenen Bereich...</MudText>
            <MudImage Class="my-6" Src="images/monkey_face.png" Width="256" Height="256"></MudImage>
            <MudAlert Severity="Severity.Warning">
                Das Anlegen von eigenen Bereichen ist noch in Arbeit.
                <br />
                Bitte schau zu einem späteren Zeitpunkt wieder vorbei oder wende Dich an den Administrator.
            </MudAlert>
        </div>
    }
}

@code {
    [CascadingParameter]
    private Identity User { get; set; } = default!;

    private bool _isLoading = true;

    private readonly Dictionary<string, Transaction?> _lastTransactions = new();

    private List<Account> _accounts = new();
    private AccountOwner? _accountOwner = null;

    protected override async Task OnParametersSetAsync()
    {
        if (User != null)
        {
            if (User.IsEnabled)
            {
                _accounts = await Accounts.GetAllAsync(User.TenantKey);

                foreach (var account in _accounts)
                {
                    _lastTransactions[account.AccountKey] = await Transactions.GetLatestAsync(User.TenantKey, account.AccountKey);
                }
            }
            else if (User.IsKnown)
            {
                _accountOwner = await AccountOwners.GetByEmailAsync(User.Email);
            }
        }

        _isLoading = false;
    }

    private async Task AddAccount()
    {
        var dialog = await Dialog.ShowAsync<AccountCreationDialog>(
            "Im Dutzend billiger?",
            new DialogParameters<AccountCreationDialog>(),
            new DialogOptions()
                {
                    MaxWidth = MaxWidth.Small,
                });

        var result = await dialog.Result;

        if (result?.Data != null && result.Data is string accountName)
        {
            var account = await AccountManagement.CreateAccount(User.TenantKey, accountName);

            if (account != null)
            {
                Navigation.NavigateTo($"/account/{User.TenantKey}/{account.AccountKey}/edit");
            }
        }
    }

    private void ThrowTestError()
    {
        throw new InvalidOperationException("Provoked test exception");
    }

    private void GotoAccountDetails(string accountKey)
    {
        Navigation.NavigateTo($"/account/{User.TenantKey}/{accountKey}");
    }

    private void GotoAccountEdit(string accountKey)
    {
        Navigation.NavigateTo($"/account/{User.TenantKey}/{accountKey}/edit");
    }
}
