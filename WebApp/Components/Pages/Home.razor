@page "/"

@using System.Security.Principal
@using System.Globalization

@using MONkEY.Data
@using MONkEY.Data.Services

@inject IAccountService Accounts
@inject ITransactionService Transactions
@inject NavigationManager Navigation

<PageTitle>MONkEY App</PageTitle>

@if (_isLoading)
{
    <PageLoader />
}
else if (_accounts != null)
{
    <div class="d-flex flex-grow-1 flex-wrap gap-4 pa-4">
        @foreach (var account in _accounts)
        {
            var transaction = _lastTransactions[account.AccountKey];

            var accountImageSrc = !string.IsNullOrEmpty(account.Image)
                ? $"api/image/{account.TenantKey}/{account.Image}"
                : "images/monkey_face.png";

            <MudCard Class="flex-auto d-flex" Elevation="5">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary">@account.Name.Substring(0, 1).ToUpper()</MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5">@account.Name</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="() => GotoAccountEdit(account.AccountKey)" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardMedia Image="@accountImageSrc" Class="cursor-pointer" @onclick="() => GotoAccountDetails(account.AccountKey)" />
                <MudCardContent>
                    <MudText Typo="Typo.body1">Aktuelles Guthaben: @account.Balance€</MudText>
                    @if (transaction != null)
                    {
                        <MudText Typo="Typo.caption">Letzte Transaktion am <LocalTime DateTime="@transaction.Timestamp!.Value.UtcDateTime" Format="g" /></MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">Keine Transaktionen vorhanden</MudText>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => GotoAccountDetails(account.AccountKey)">Auswählen</MudButton>
                </MudCardActions>
            </MudCard>
        }
    </div>
}

@code {
    private const string TENANT = "klerner";

    private bool _isLoading = true;

    private readonly Dictionary<string, Transaction?> _lastTransactions = new();

    private List<Account>? _accounts;

    protected async override Task OnInitializedAsync()
    {
        _accounts = await Accounts.GetAllAsync(TENANT);

        foreach (var account in _accounts)
        {
            _lastTransactions[account.AccountKey] = await Transactions.GetLatestAsync(account.TenantKey, account.AccountKey);
        }

        _isLoading = false;
    }

    private void GotoAccountDetails(string accountKey)
    {
        Navigation.NavigateTo($"/{TENANT}/account/{accountKey}");
    }

    private void GotoAccountEdit(string accountKey)
    {
        Navigation.NavigateTo($"/{TENANT}/account/{accountKey}/edit");
    }
}
