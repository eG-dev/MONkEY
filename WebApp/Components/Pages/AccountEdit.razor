@page "/account/{TenantKey}/{AccountKey}/edit"

@inject NavigationManager Navigation
@inject IAccountManagementService AccountManagement
@inject IAccountService Accounts
@inject IDialogService Dialog

<PageTitle>POCKET MONkEY - Konto bearbeiten</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">" MaxItems="2"></MudBreadcrumbs>
</div>

@if (_account != null)
{
    if (!User.IsAllowedToManage)
    {
        <MudAlert Class="mb-6" Severity="Severity.Info">Du darfst dieses Konto nicht bearbeiten.</MudAlert>
    }

    var accountImageSrc = AccountManagement.GetImageSrc(_account);

    <div class="d-flex gap-6 justify-start align-center">
        <MudAvatar>
            <MudImage Src="@accountImageSrc"></MudImage>
        </MudAvatar>
        <AccountName Text="@_account.Name" />
    </div>

    <MudGrid>
        <MudItem xs="12" md="8" lg="6">
            <MudTextField T="string"
                          Class="mt-6"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Value="@_account.Name"
                          MaxLength="25"
                          ReadOnly="@(User.IsAllowedToManage == false)"
                          OnlyValidateIfDirty="true"
                          Validation="@(new Func<string, IEnumerable<string>>(ValidateName))"
                          DebounceInterval="1000"
                          ValueChanged="OnNameChanged" />
        </MudItem>
    </MudGrid>

    <MudBreakpointProvider>
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudImage Class="mt-6 rounded-lg" Src="@accountImageSrc" Width="256" Height="256" Elevation="5"></MudImage>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
            <MudImage Class="mt-6 rounded-lg" Src="@accountImageSrc" Width="512" Height="512" Elevation="5"></MudImage>
        </MudHidden>
    </MudBreakpointProvider>

    if (User.IsAllowedToManage)
    {
        <div class="mt-1">
            <MudButton Variant="Variant.Filled"
            Color="Color.Primary"
            StartIcon="@Icons.Material.TwoTone.Edit"
            Style="min-width: 150px"
            OnClick="InitiateImageUpdate">
                Bild ändern
            </MudButton>
        </div>

        <MudText Class="mt-12" Typo="Typo.h6" Color="Color.Error">Risikozone</MudText>
        
        <div class="mt-3">
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.TwoTone.Delete"
                       Style="min-width: 150px"
                       OnClick="InitiateDeletion">
                Konto löschen
            </MudButton>
        </div>
    }

    <MudOverlay @bind-Visible="_isUpdating" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
}
else if (_isLoading)
{
    <PageLoader />
}
else
{
    <MudAlert Severity="Severity.Error">Das Konto ist nicht bekannt!</MudAlert>
}

@code {
    [CascadingParameter]
    private User User { get; set; } = default!;

    [Parameter]
    public string TenantKey { get; set; } = default!;

    [Parameter]
    public string AccountKey { get; set; } = default!;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Übersicht", "/", false, Icons.Material.TwoTone.Home)
    };

    private bool _isLoading = true;
    private bool _isUpdating = false;

    private Account? _account = null;

    protected async override Task OnInitializedAsync()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(TenantKey) && !string.IsNullOrWhiteSpace(AccountKey))
        {
            _account = await Accounts.GetAsync(TenantKey, AccountKey);

            if (_account != null)
            {
                _breadcrumbs.Add(new BreadcrumbItem(
                    _account.Name,
                    $"/account/{_account.TenantKey}/{_account.AccountKey}",
                    false,
                    Icons.Material.TwoTone.Wallet));

                _breadcrumbs.Add(new BreadcrumbItem(
                    "Bearbeiten",
                    $"/account/{_account.TenantKey}/{_account.AccountKey}/edit",
                    false,
                    Icons.Material.TwoTone.Edit));
            }
        }

        _isLoading = false;
    }

    private IEnumerable<string> ValidateName(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            yield return "Das Konto benötigt einen Namen!";
        }
    }

    private async Task OnNameChanged(string name)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            _account!.Name = name;
            _account = await Accounts.UpdateAsync(_account);

            _breadcrumbs[1] = new BreadcrumbItem(
                _account!.Name,
                $"/account/{_account.TenantKey}/{_account.AccountKey}",
                false,
                Icons.Material.TwoTone.Wallet);
        }
    }

    private async Task InitiateImageUpdate()
    {
        string imageSrc = string.Empty;
        
        if (!string.IsNullOrEmpty(_account?.Image))
        {
            imageSrc = AccountManagement.GetImageSrc(_account);
        }

        var dialog = await Dialog.ShowAsync<ImageSelectionDialog>(
            "Bild ändern",
            new DialogParameters<ImageSelectionDialog>()
            {
                { x => x.Src, imageSrc }
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Large,
            });

        var result = await dialog.Result;

        if (result != null &&
            !result.Canceled && result.Data is ImageSelectionDialogModel model &&
            !string.IsNullOrEmpty(model.ImageDataBase64))
        {
            _isUpdating = true;
            StateHasChanged();

            try
            {
                _account = await AccountManagement.UpdateImage(User, _account!.AccountKey, model.ImageDataBase64);
            }
            catch { }
            finally
            {
                _isUpdating = false;
                StateHasChanged();
            }
        }
    }

    private async Task InitiateDeletion()
    {
        var dialog = await Dialog.ShowAsync<AccountDeletionDialog>(
            "Zwo, Eins, Risiko!",
            new DialogParameters<AccountDeletionDialog>()
            {
                { x => x.AccountName, _account!.Name }
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Small,
            });

        var result = await dialog.Result;

        if (result?.Data != null && (bool)result.Data == true)
        {
            _isUpdating = true;
            StateHasChanged();

            await AccountManagement.Delete(User, _account.AccountKey);

            Navigation.NavigateTo("/");
        }
    }
}
