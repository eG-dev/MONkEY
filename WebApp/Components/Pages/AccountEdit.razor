@page "/account/{TenantKey}/{AccountKey}/edit"

@using Microsoft.AspNetCore.Components.Authorization

@using MONkEY.WebApp.DTO
@using MONkEY.Data
@using MONkEY.Data.Services

@inject NavigationManager Navigation
@inject AccountManagementService AccountManagement
@inject IAccountService Accounts
@inject IDialogService Dialog

<PageTitle>MONkEY App - Konto bearbeiten</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">"></MudBreadcrumbs>
</div>

@if (_account != null)
{
    var accountImageSrc = !string.IsNullOrEmpty(_account.Image)
        ? $"api/image/{_account.TenantKey}/{_account.Image}"
        : "images/monkey_face.png";

    <div class="d-flex gap-6 justify-start align-center">
        <MudAvatar>
            <MudImage Src="@accountImageSrc"></MudImage>
        </MudAvatar>
        <AccountName Text="@_account.Name" />
    </div>

    <MudGrid>
        <MudItem xs="12" md="8" lg="6">
            <MudTextField T="string"
                          Class="mt-6"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Value="@_account.Name"
                          MaxLength="24"
                          Error="@(!string.IsNullOrEmpty(_accountNameError))"
                          ErrorText="@_accountNameError"
                          DebounceInterval="1000"
                          ValueChanged="OnNameChanged" />
        </MudItem>
    </MudGrid>

    <MudBreakpointProvider>
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudImage Class="rounded-lg my-3" Src="@accountImageSrc" Width="256" Height="256" Elevation="5"></MudImage>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
            <MudImage Class="rounded-lg my-3" Src="@accountImageSrc" Width="512" Height="512" Elevation="5"></MudImage>
        </MudHidden>
    </MudBreakpointProvider>

    <div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Style="min-width: 150px"
                   OnClick="InitiateImageUpdate">
            Bild ändern
        </MudButton>
    </div>
    <div class="mt-6">
        <MudButton Variant="Variant.Text"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   Style="min-width: 150px"
                   OnClick="InitiateDeletion">
            Konto löschen
        </MudButton>
    </div>

    <MudOverlay @bind-Visible="_isUpdating" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
}
else if (_isLoading)
{
    <PageLoader />
}
else
{
    <MudAlert Severity="Severity.Error">Das Konto ist nicht bekannt!</MudAlert>
}

@code {
    [Parameter]
    public string TenantKey { get; set; } = default!;

    [Parameter]
    public string AccountKey { get; set; } = default!;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Übersicht", "/", false, Icons.Material.TwoTone.Home)
    };

    private bool _isLoading = true;
    private bool _isUpdating = false;

    private Account? _account = null;

    private string? _accountNameError = default!;

    protected async override Task OnInitializedAsync()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(TenantKey) && !string.IsNullOrWhiteSpace(AccountKey))
        {
            _account = await Accounts.GetAsync(TenantKey, AccountKey);

            if (_account != null)
            {
                _breadcrumbs.Add(new BreadcrumbItem(
                    _account.Name,
                    $"/account/{_account.TenantKey}/{_account.AccountKey}",
                    false,
                    Icons.Material.TwoTone.Wallet));

                _breadcrumbs.Add(new BreadcrumbItem(
                    "Bearbeiten",
                    $"/account/{_account.TenantKey}/{_account.AccountKey}/edit",
                    false,
                    Icons.Material.Filled.Edit));
            }
        }

        _isLoading = false;
    }

    private async Task OnNameChanged(string name)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            _accountNameError = null;

            _account!.Name = name;
            _account = await Accounts.UpdateAsync(_account);

            _breadcrumbs[1] = new BreadcrumbItem(
                _account!.Name,
                $"/account/{_account.TenantKey}/{_account.AccountKey}",
                false,
                Icons.Material.TwoTone.Wallet);
        }
        else
        {
            _accountNameError = "Das Konto benötigt einen Namen!";
        }
    }

    private async Task InitiateImageUpdate()
    {
        string imageSrc = string.Empty;
        if (!string.IsNullOrEmpty(_account!.Image))
        {
            imageSrc = $"api/image/{_account.TenantKey}/{_account.Image}";
        }

        var dialog = await Dialog.ShowAsync<ImageSelectionDialog>(
            "Bild ändern",
            new DialogParameters<ImageSelectionDialog>()
            {
                { x => x.Src, imageSrc }
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Large,
            });

        var result = await dialog.Result;

        if (result != null &&
            !result.Canceled && result.Data is ImageSelectionDialogModel model &&
            !string.IsNullOrEmpty(model.ImageDataBase64))
        {
            _isUpdating = true;
            StateHasChanged();

            try
            {
                _account = await AccountManagement.UpdateImage(_account.TenantKey, _account.AccountKey, model.ImageDataBase64);
            }
            catch { }
            finally
            {
                _isUpdating = false;
                StateHasChanged();
            }
        }
    }

    private async Task InitiateDeletion()
    {
        var dialog = await Dialog.ShowAsync<AccountDeletionDialog>(
            "Zwo, Eins, Risiko!",
            new DialogParameters<AccountDeletionDialog>()
            {
                { x => x.AccountName, _account!.Name }
            },
            new DialogOptions()
            {
                MaxWidth = MaxWidth.Small,
            });

        var result = await dialog.Result;

        if (result?.Data != null && (bool)result.Data == true)
        {
            _isUpdating = true;
            StateHasChanged();

            await AccountManagement.DeleteAccount(_account!.TenantKey, _account.AccountKey);

            Navigation.NavigateTo("/");
        }
    }
}
