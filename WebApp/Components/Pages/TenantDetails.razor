@page "/tenant/{TenantKey?}"

@inject ITenantManagementService TenantManagement
@inject ITenantMemberService AccountOwners
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>POCKET MONkEY - Mein Bereich</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">" MaxItems="2"></MudBreadcrumbs>
</div>

@if (_accountOwners == null)
{
    <PageLoader />
}
else if (_accountOwners.Count > 0)
{
    <MudText Typo="Typo.h6">Nutzer</MudText>

    @if (User.IsAllowedToManage)
    {
        <div class="mb-1 d-flex flex-row justify-end">
            <MudButton Variant="Variant.Text"
            Color="Color.Primary"
            StartIcon="@Icons.Material.TwoTone.Add"
            Style="min-width: 150px"
            OnClick="InitiateUserInvitation">
                Nutzer hinzufügen
            </MudButton>
        </div>
    }

    <div class="pb-3">
        <MudTable Items="@_accountOwners"
        Hover="true"
        Dense="true"
        Striped="true"
        Breakpoint="Breakpoint.Sm"
        LoadingProgressColor="Color.Info">

            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Rolle</MudTh>
                <MudTh>Status</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email">
                    @if (context.Email == User.Email)
                    {
                        <b>@context.Email</b>
                    }
                    else
                    {
                        @context.Email
                    }
                </MudTd>
                <MudTd DataLabel="Rolle">@_roles[context.Role]</MudTd>
                <MudTd DataLabel="Status">@_statuus[context.Status]</MudTd>
                <MudTd>
                    @if (User.IsAllowedToManage && User.Email != context.Email)
                    {
                        <div class="d-flex flex-row justify-end">
                            <MudButton Size="@Size.Small" 
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.TwoTone.Delete"
                                       OnClick="() => InitiateUserDeletion(context.Email)">
                                Nutzer entfernen
                            </MudButton>
                        </div>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>

    if (User.IsAllowedToManage)
    {
        <MudText Class="mt-12" Typo="Typo.h6" Color="Color.Error">Risikozone</MudText>

        <div Class="mt-3" >
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.TwoTone.Delete"
                       Style="min-width: 150px"
                       OnClick="InitiateTenantDeletion">
                Bereich löschen
            </MudButton>
        </div>
    }

    <MudOverlay @bind-Visible="_isUpdating" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
}
else
{
    <MudAlert Severity="Severity.Error">Der Bereich ist nicht bekannt!</MudAlert>
}

@code {
    [CascadingParameter]
    private User User { get; set; } = default!;

    [Parameter]
    public string TenantKey { get; set; } = default!;

    private Dictionary<TenantMemberRole, string> _roles = new()
    {
        { TenantMemberRole.Undefined, "Ungültig" },
        { TenantMemberRole.Member, "Nutzer" },
        { TenantMemberRole.Manager, "Verwalter" },
        { TenantMemberRole.GlobalAdmin, "Administrator" },
    };

    private Dictionary<TenantMemberStatus, string> _statuus = new()
    {
        { TenantMemberStatus.Undefined, "Ungültig" },
        { TenantMemberStatus.Invited, "Eingeladen" },
        { TenantMemberStatus.Pending, "Anstehend" },
        { TenantMemberStatus.Active, "Aktiv" },
        { TenantMemberStatus.Disabled, "Gesperrt" },
    };

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Übersicht", "/", false, Icons.Material.TwoTone.Home)
    };

    private bool _isUpdating = false;

    private List<TenantMember>? _accountOwners = null;

    protected async override Task OnInitializedAsync()
    {
        if (_accountOwners == null)
        {
            if (!string.IsNullOrWhiteSpace(TenantKey))
            {
                _accountOwners = await AccountOwners.GetTenantMembersAsync(TenantKey);

                _breadcrumbs.Add(new BreadcrumbItem(
                    "Mein Bereich",
                    $"/tenant/{TenantKey}",
                    false,
                    Icons.Material.TwoTone.AdminPanelSettings));
            }
            else
            {
                _accountOwners = new();
            }
        }
    }

    private async Task InitiateUserInvitation()
    {
        var dialog = await Dialogs.ShowAsync<UserInvitationDialog>(
            "Nutzer hinzufügen",
            new DialogParameters<UserInvitationDialog>(),
            new DialogOptions()
                {
                    MaxWidth = MaxWidth.Small,
                });

        var result = await dialog.Result;

        if (result != null &&
            result.Data is InvitationDialogModel model &&
            !string.IsNullOrWhiteSpace(model.Email))
        {
            _isUpdating = true;

            var existingOwner = await AccountOwners.GetByEmailAsync(model.Email);

            if (existingOwner != null)
            {
                _isUpdating = false;

                Snackbar.Add(existingOwner.TenantKey == User.TenantKey
                    ? $"Der Nutzer '{model.Email}' ist bereits Teil des Bereichs!"
                    : $"Der Nutzer '{model.Email}' ist bereits einem anderen Bereich zugewiesen!",
                    Severity.Error);
            }
            else
            {
                try
                {
                    TenantMemberRole role = model.AssignManagerRole
                        ? TenantMemberRole.Manager
                        : TenantMemberRole.Member;

                    await TenantManagement.InviteUser(User, model.Email, role);

                    _accountOwners = await AccountOwners.GetTenantMembersAsync(TenantKey);

                    Snackbar.Add($"Der Nutzer '{model.Email}' wurde zum Bereich hinzugefügt.", Severity.Success);
                }
                catch
                {
                    Snackbar.Add($"Der Nutzer '{model.Email}' konnte nicht zum Bereich hinzugefügt werden!", Severity.Error);
                }
                finally
                {
                    _isUpdating = false;
                }
            }
        }
    }

    private async Task InitiateUserDeletion(string email)
    {
        var dialog = await Dialogs.ShowAsync<UserDeletionDialog>(
            "Nutzer löschen",
            new DialogParameters<UserDeletionDialog>()
                {
                    { x => x.Email, email }
                },
            new DialogOptions()
                {
                    MaxWidth = MaxWidth.Small,
                });

        var result = await dialog.Result;

        if (result?.Data != null && (bool)result.Data == true)
        {
            _isUpdating = true;

            try
            {
                await TenantManagement.DeleteUser(User, email);

                _accountOwners = await AccountOwners.GetTenantMembersAsync(TenantKey);

                Snackbar.Add($"Der Nutzer '{email}' wurde erfolgreich gelöscht.", Severity.Success);
            }
            catch
            {
                Snackbar.Add($"Der Nutzer konnte nicht gelöscht werden!", Severity.Error);
            }
            finally
            {
                _isUpdating = false;
            }
        }
    }

    private async Task InitiateTenantDeletion()
    {
        var dialog = await Dialogs.ShowAsync<TenantDeletionDialog>(
            "Uh-oh, immer mit der Ruhe!",
            new DialogParameters<TenantDeletionDialog>(),
            new DialogOptions()
                {
                    MaxWidth = MaxWidth.Small,
                });

        var result = await dialog.Result;

        if (result?.Data != null && (bool)result.Data == true)
        {
            _isUpdating = true;

            try
            {
                await TenantManagement.DeleteTenant(User);

                // Hard reload bypassing cache, because the tenant context is cached in the MainLayout
                await JS.InvokeVoidAsync("location.reload", true);
            }
            catch
            {
                Snackbar.Add($"Der Bereich konnte nicht gelöscht werden!", Severity.Error);
            }
            finally
            {
                _isUpdating = false;
            }
        }
    }
}
