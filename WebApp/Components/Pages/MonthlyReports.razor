@page "/tenant/{TenantKey}/monthlyreports"

@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Navigation
@inject IReportService Reports
@inject IAccountOwnerService AccountOwners
@inject IEmailTriggerService Emails
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>POCKET MONkEY - Monatsberichte</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">" MaxItems="2"></MudBreadcrumbs>
</div>

@if (_reports == null)
{
    <PageLoader />
}
else
{
    <MudCheckBox T="bool" Value="_receiveMonthlyReports" ValueChanged="UpdateMonthlyReportSettings">
        Ich möchte die Monatsberichte automatisch per E-Mail zugesendet bekommen
    </MudCheckBox>

    <MudText Class="mt-6" Typo="Typo.h6">Monatsberichte</MudText>

    <div class="pb-3">
        <MudTable T="Report" Items="@_reports"
        Hover="true"
        Dense="true"
        Striped="true"
        Breakpoint="Breakpoint.Sm"
        LoadingProgressColor="Color.Info">
            <NoRecordsContent>
                Keine Berichte vorhanden...
            </NoRecordsContent>
            <HeaderContent>
                <MudTh>Zeitraum</MudTh>
                <MudTh>Konto</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Abschlussbilanz</MudTh>
                <MudTh>Ausgangsbilanz</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Zeitraum">
                    @context.ReportedPeriod!.Value.ToString("d") - @context.ReportedPeriod!.Value.EndOfMonth().ToString("d")
                </MudTd>
                <MudTd DataLabel="Konto">@_reportPayloads![context.RowKey].AccountName</MudTd>
                <MudTd DataLabel="Name">@_reportPayloads![context.RowKey].ReportedPeriodName</MudTd>
                <MudTd DataLabel="Abschlussbilanz">
                    <Amount Value="@_reportPayloads![context.RowKey].ClosingBalance" Unit="€" IsBold="true" />
                </MudTd>
                <MudTd DataLabel="Ausgangsbilanz">
                    <Amount Value="@_reportPayloads![context.RowKey].StartingBalance" Unit="€" />
                </MudTd>
                <MudTd>
                    <div class="d-flex flex-row justify-end">
                        <MudButton Size="@Size.Small"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.TwoTone.ReadMore"
                                   OnClick="() => ToggleReportDetails(context)">
                            Details
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.RowKey == _detailsRowKey)
                {
                    <MudTr>
                        <td colspan="6" style="padding: 6px 12px">
                            <div style="display: flex; justify-content: flex-end">
                                <MudButton StartIcon="@Icons.Material.TwoTone.ForwardToInbox"
                                           OnClick="() => TriggerEmailDelivery(context)">
                                    Per E-Mail zusenden
                                </MudButton>
                            </div>
                        </td>
                    </MudTr>
                    <MudTr>
                        <td colspan="6" style="padding: 0 12px 6px 6px">
                            @foreach (var transaction in _reportPayloads![context.RowKey].Transactions)
                            {
                                <div style="font-size: smaller; margin-top: 12px">
                                    @transaction.TriggeredOn - @transaction.TriggeredBy
                                </div>
                                <Amount Value="@transaction.Amount" Unit="€" />
                                <div style="font-size: smaller">
                                    <i>@transaction.Comment</i>
                                </div>
                            }
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudTable>
    </div>

    <MudOverlay @bind-Visible="_isUpdating" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
}

@code {
    [CascadingParameter]
    private User User { get; set; } = default!;

    [Parameter]
    public string TenantKey { get; set; } = default!;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Übersicht", "/", false, Icons.Material.TwoTone.Home)
    };

    private bool _isUpdating = false;

    private List<Report>? _reports = null;
    private Dictionary<string, MonthlyReportPayload>? _reportPayloads = null;

    private bool _receiveMonthlyReports = false;

    private string? _detailsRowKey = null;

    protected async override Task OnInitializedAsync()
    {
        _receiveMonthlyReports = User.Preferences.IsMonthlyReportingEnabled;

        if (_reports == null)
        {
            if (!string.IsNullOrWhiteSpace(TenantKey))
            {
                _reports = await Reports.GetAsync(TenantKey, ReportType.Monthly);

                _reportPayloads = _reports.ToDictionary(
                    r => r.RowKey,
                    r => System.Text.Json.JsonSerializer.Deserialize<MonthlyReportPayload>(r.SerializedPayload))!;
            }
            else
            {
                _reports = new();
                _reportPayloads = new();
            }

            _breadcrumbs.Add(new BreadcrumbItem(
                "Monatsberichte",
                $"/tenant/{TenantKey}/monthlyreports",
                false,
                Icons.Material.TwoTone.ReceiptLong));
        }
    }

    private async Task UpdateMonthlyReportSettings(bool receiveMonthlyReports)
    {
        _isUpdating = true;

        try
        {
            _receiveMonthlyReports = receiveMonthlyReports;

            var preferences = User.Preferences;
            preferences.IsMonthlyReportingEnabled = receiveMonthlyReports;

            await AccountOwners.UpdatePreferencesAsync(User.Email, preferences);

            User.Preferences.IsMonthlyReportingEnabled = _receiveMonthlyReports;
        }
        catch
        {
            Snackbar.Add($"Die Aktion konnte nicht durchgeführt werden!", Severity.Error);
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private void ToggleReportDetails(Report report)
    {
        if (_detailsRowKey == report.RowKey)
        {
            _detailsRowKey = null;
        }
        else
        {
            _detailsRowKey = report.RowKey;
        }
    }

    private async Task TriggerEmailDelivery(Report report)
    {
        _isUpdating = true;
        StateHasChanged();

        try
        {
            await Emails.TriggerMonthlyReport([User.Email], report.SerializedPayload);

            // Virtual delay to prevent misusage (e.g. spamming)
            await Task.Delay(1000);

            Snackbar.Add($"Der Monatsbericht wurde in den E-Mail-Versand übergeben.", Severity.Success);
        }
        catch
        {
            Snackbar.Add($"Die Aktion konnte nicht durchgeführt werden!", Severity.Error);
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }
}
