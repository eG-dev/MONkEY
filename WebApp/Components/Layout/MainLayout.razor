@using Microsoft.AspNetCore.Components.Authorization

@using MONkEY.Data
@using MONkEY.Data.Services

@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IIdentityService Identity
@inject UsageTermsService UsageTerms

<InitializeTimeZone />

<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />

<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.Medium"
                   CloseButton="true"
                   BackdropClick="false"
                   NoHeader="false"
                   Position="DialogPosition.TopCenter"
                   CloseOnEscapeKey="true" />

<MudSnackbarProvider/>

<MudLayout Class="page">
    <MudAppBar Color="Color.Dark" Fixed="true" Dense="false" Elevation="2">
        <MudImage Height="30" Src="/images/monkey.png" @onclick="NavigateToHome" Class="cursor-pointer"></MudImage>
        <MudSpacer />
        @if (_user != null)
        {
            <MudText Color="Color.Default">@_user</MudText>
            <MudIconButton Icon="@Icons.Material.TwoTone.Menu" Color="Color.Inherit" Edge="Edge.End" OnClick="ToggleDrawer" />
        }
        else
        {
            <MudButton StartIcon="@Icons.Custom.Brands.Microsoft" Color="Color.Inherit" Href="MicrosoftIdentity/Account/SignIn">Anmelden</MudButton>
        }
    </MudAppBar>

    @if (_user != null)
    {
        <MudDrawer Variant="DrawerVariant.Temporary" Anchor="Anchor.End" Elevation="1" @bind-Open="@_drawerOpen">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">@_user</MudText>
            </MudDrawerHeader>
            <MudButton StartIcon="@Icons.Material.TwoTone.AdminPanelSettings" Color="Color.Inherit" Href="@($"/tenant/{_user.TenantKey}")">Mein Bereich</MudButton>
            <MudDivider DividerType="DividerType.Middle" />
            <MudButton StartIcon="@Icons.Material.TwoTone.Logout" Color="Color.Secondary" Href="MicrosoftIdentity/Account/SignOut">Abmelden</MudButton>
            <MudDivider DividerType="DividerType.Middle" />
            <MudSpacer />
            <MudButton Color="Color.Default" Href="/terms/usage-terms" OnClick="ToggleDrawer">Nutzungsbedingungen</MudButton>
            <MudButton Color="Color.Default" Href="/terms/data-privacy" OnClick="ToggleDrawer">Datenschutzerklärung</MudButton>
        </MudDrawer>
    }

    <MudMainContent>
        <MudContainer Class="page-container pb-3">
            <ErrorBoundary>
                <ChildContent>
                    @if (Navigation.Uri.Contains("/terms"))
                    {
                        @Body
                    }
                    else
                    {
                        <CascadingAuthenticationState>
                            <AuthorizeView>
                                <Authorized>
                                    @if (_user == null)
                                    {
                                        <PageLoader />
                                    }
                                    else if (!UsageTerms.HasAcceptedUsageTerms(_user))
                                    {
                                        <UsageTermsView />

                                        <div class="d-flex flex-row align-center mt-6">
                                            <MudButton Variant="Variant.Filled"
                                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                                       Color="Color.Success"
                                                       OnClick="AcceptUsageTerms">
                                                Akzeptieren und fortfahren
                                            </MudButton>
                                        </div>
                                    }
                                    else if (_user.Status != AccountOwnerStatus.Active)
                                    {
                                        <AccountOwnerActions User="@_user" />
                                    }
                                    else
                                    {
                                        <CascadingValue Value="@_user">
                                            @Body
                                        </CascadingValue>
                                    }
                                </Authorized>
                                <NotAuthorized>
                                    <Welcome />
                                </NotAuthorized>
                            </AuthorizeView>
                        </CascadingAuthenticationState>
                    }
                </ChildContent>
                <ErrorContent>
                    <GlobalError Error="@context" />
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme Theme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = Colors.Indigo.Default,
                Success = Colors.Green.Darken2,
                Error = Colors.Red.Darken4,
            },
        };

    private bool _drawerOpen = false;

    private Identity? _user = default!;

    protected async override Task OnInitializedAsync()
    {
        if (_user == null)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _user = await Identity.FromPrincipal(authState.User);
        }
    }

    private async Task AcceptUsageTerms()
    {
        if (_user != null)
        {
            await UsageTerms.Accept(_user);

            Navigation.NavigateTo("/", true);
        }
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
