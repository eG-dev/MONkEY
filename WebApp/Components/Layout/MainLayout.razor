@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IUserService UserService
@inject IUsageTermsService UsageTerms

@inject ITimeZoneService TimeZoneService

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />

<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.Medium"
                   CloseButton="true"
                   BackdropClick="false"
                   NoHeader="false"
                   Position="DialogPosition.TopCenter"
                   CloseOnEscapeKey="true" />

<MudSnackbarProvider/>

<MudLayout Class="page">
    @if (_isInitializing)
    {
        <MudOverlay Absolute="true" Visible="true">
            <MudText Typo="Typo.h6">Initialisierung...</MudText>
        </MudOverlay>
    }
    else
    {
        if (!IsOldDomain)
        {
            <MudAppBar Color="Color.Dark" Fixed="true" Dense="false" Elevation="2">
                <MudImage Height="30" Src="/images/monkey.png" @onclick="NavigateToHome" Class="cursor-pointer"></MudImage>
                <MudSpacer />
                @if (_user != null)
                {
                    <MudText Color="Color.Default">@_user</MudText>

                    <MudIconButton Icon="@Icons.Material.TwoTone.Menu"
                                   Color="Color.Inherit"
                                   Edge="Edge.End"
                                   OnClick="ToggleDrawer" />
                }
                else
                {
                    <MudButton StartIcon="@Icons.Custom.Brands.Microsoft"
                               Color="Color.Inherit"
                               Href="MicrosoftIdentity/Account/SignIn">
                        Anmelden
                    </MudButton>
                }
            </MudAppBar>
        }

        if (_user != null)
        {
            <MudDrawer Variant="DrawerVariant.Temporary" Anchor="Anchor.End" Elevation="1" @bind-Open="@_drawerOpen">
                <MudDrawerHeader>
                    <MudText Typo="Typo.h6">@_user</MudText>
                </MudDrawerHeader>
                <MudButton StartIcon="@Icons.Material.TwoTone.AdminPanelSettings"
                           Color="Color.Inherit"
                           Href="@($"/tenant/{_user.TenantKey}")"
                           OnClick="ToggleDrawer">
                    Mein Bereich
                </MudButton>
                <MudButton StartIcon="@Icons.Material.TwoTone.ReceiptLong"
                           Color="Color.Inherit"
                           Href="@($"/tenant/{_user.TenantKey}/monthlyreports")"
                           OnClick="ToggleDrawer">
                    Monatsberichte
                </MudButton>
                <MudDivider Class="my-3" DividerType="DividerType.Middle" />
                <MudButton StartIcon="@Icons.Material.TwoTone.Logout"
                           Color="Color.Secondary"
                           Href="MicrosoftIdentity/Account/SignOut">
                    Abmelden
                </MudButton>
                <MudSpacer />
                <MudButton Color="Color.Default"
                           Href="/terms/usage-terms"
                           OnClick="ToggleDrawer">
                    Nutzungsbedingungen
                </MudButton>
                <MudButton Color="Color.Default"
                           Href="/terms/data-privacy"
                           OnClick="ToggleDrawer">
                    Datenschutzerklärung
                </MudButton>
            </MudDrawer>
        }

        <MudMainContent Class="page-content">
            <MudContainer Class="page-container pb-3">
                <ErrorBoundary>
                    <ChildContent>
                        @if (Navigation.Uri.Contains("/terms"))
                        {
                            @Body
                        }
                        else if (IsOldDomain)
                        {
                            <NewDomainInfo />
                        }
                        else
                        {
                            <CascadingAuthenticationState>
                                <AuthorizeView>
                                    <Authorized>
                                        @if (_user == null)
                                        {
                                            <PageLoader />
                                        }
                                        else if (_user.Status != AccountOwnerStatus.Undefined && !UsageTerms.HasAcceptedUsageTerms(_user))
                                        {
                                            <UsageTermsView />

                                            <div class="d-flex flex-row align-center mt-6">
                                                <MudButton Variant="Variant.Filled"
                                                           StartIcon="@Icons.Material.TwoTone.CheckCircle"
                                                           Color="Color.Success"
                                                           OnClick="AcceptUsageTerms">
                                                    Akzeptieren und fortfahren
                                                </MudButton>
                                            </div>
                                        }
                                        else if (_user.Status != AccountOwnerStatus.Active)
                                        {
                                            <AccountOwnerActions User="@_user" />
                                        }
                                        else
                                        {
                                            <CascadingValue Value="@_user">
                                                @Body
                                            </CascadingValue>
                                        }
                                    </Authorized>
                                    <NotAuthorized>
                                        <Welcome />
                                    </NotAuthorized>
                                </AuthorizeView>
                            </CascadingAuthenticationState>
                        }
                    </ChildContent>
                    <ErrorContent>
                        <GlobalError Error="@context" />
                    </ErrorContent>
                </ErrorBoundary>
            </MudContainer>
        </MudMainContent>
    }
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Indigo.Default,
            Success = Colors.Green.Darken2,
            Error = Colors.Red.Darken4,
        },
    };

    private bool _isInitializing = true;
    private bool _drawerOpen = false;

    private User? _user = default!;

    private bool IsOldDomain { get => Navigation.Uri.Contains("monkey-app.de"); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInitializing = true;

            await TimeZoneService.InitializeAsync();

            if (_user == null)
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                _user = await UserService.FromPrincipal(authState.User);
            }

            _isInitializing = false;

            StateHasChanged();
        }
    }

    private async Task AcceptUsageTerms()
    {
        if (_user != null)
        {
            await UsageTerms.Accept(_user);

            Navigation.NavigateTo("/", true);
        }
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
