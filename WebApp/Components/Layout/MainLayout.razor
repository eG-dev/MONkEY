@using Microsoft.AspNetCore.Components.Authorization

@using MONkEY.Data
@using MONkEY.Data.Services

@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IIdentityService Identity
@inject NavigationManager Navigation
@inject IAccountOwnerService Owners

<InitializeTimeZone />

<MudThemeProvider/>
<MudPopoverProvider/>

<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.Medium"
                   CloseButton="true"
                   BackdropClick="false"
                   NoHeader="false"
                   Position="DialogPosition.TopCenter"
                   CloseOnEscapeKey="true" />

<MudSnackbarProvider/>

<MudLayout Class="page">
    <MudAppBar Color="Color.Dark" Fixed="true" Dense="false" Elevation="2">
        <MudImage Height="30" Src="/images/monkey.png" @onclick="() => NavigateToHome()" Class="cursor-pointer"></MudImage>
        <MudSpacer />
        @if (_user?.IsKnown() == true)
        {
            <MudText Color="Color.Default">@_user</MudText>
            <MudIconButton Icon="@Icons.Material.TwoTone.Menu" Color="Color.Inherit" Edge="Edge.End" OnClick="@(() => ToggleDrawer())" />
        }
        else
        {
            <MudButton StartIcon="@Icons.Material.TwoTone.Login" Color="Color.Inherit" Href="MicrosoftIdentity/Account/SignIn">Anmelden</MudButton>
        }
    </MudAppBar>

    @if (_user?.IsKnown() == true)
    {
        <MudDrawer Variant="DrawerVariant.Temporary" Anchor="Anchor.End" Elevation="1" @bind-Open="@_drawerOpen">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">@_user</MudText>
            </MudDrawerHeader>

            <MudButton StartIcon="@Icons.Material.TwoTone.Logout" Color="Color.Secondary" Href="MicrosoftIdentity/Account/SignOut">Abmelden</MudButton>
        </MudDrawer>
    }

    <MudMainContent>
        <MudContainer Class="page-container">
            <ErrorBoundary>
                <ChildContent>
                    <CascadingAuthenticationState>
                        <AuthorizeView>
                            <Authorized>
                                @if (_user == null)
                                {
                                    <PageLoader />
                                }
                                else
                                {
                                    <CascadingValue Value="@_user">
                                        @Body
                                    </CascadingValue>
                                }
                            </Authorized>
                            <NotAuthorized>
                                <div class="d-flex justify-center">
                                    <MudText Typo="@Typo.body1">Sie müssen sich anmelden, um den Inhalt zu sehen!</MudText>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </CascadingAuthenticationState>
                </ChildContent>
                <ErrorContent>
                    <GlobalError Error="@context" />
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;

    private Identity? _user = default!;

    protected async override Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = await Identity.FromPrincipal(authState.User);

        if (_user != null && string.IsNullOrEmpty(_user.TenantKey))
        {
            var tenantFallback = "df77aabf-4cb0-4f1f-ace5-642de3a0cb7c";
            
            await Owners.AddAsync(new()
            {
                PartitionKey = _user.Email,
                RowKey = tenantFallback,
                Role = AccountOwnerRole.Manager,
            });
        }
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
