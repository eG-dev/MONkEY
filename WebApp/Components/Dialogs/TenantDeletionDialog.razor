<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">Möchtest Du Deinen Bereich wirklich löschen?</MudText>

        <MudAlert Class="mt-6" Severity="Severity.Warning">
            Alle Konten werden unwiderruflich gelöscht und die Nutzer aus dem System entfernt!
        </MudAlert>

        <MudCheckBox Class="mt-3" @bind-Value="_explicitlyApproved">
            Ja, ich bin mit der Löschung des Bereichs und dem damit verbundenen Datenverlust einverstanden.
        </MudCheckBox>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.TwoTone.Delete"
                   Disabled="!_explicitlyApproved"
                   OnClick="Submit">
            Bereich löschen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private bool _explicitlyApproved = false;

    private void Submit()
    {
        if (_explicitlyApproved)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}