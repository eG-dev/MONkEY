@using MONkEY.WebApp.DTO

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">Welchen Namen hat Dein neues Konto?</MudText>

        <MudTextField T="string"
                      Class="mt-6"
                      Label="Name"
                      Variant="Variant.Outlined"
                      @bind-Value="@AccountName"
                      MaxLength="24"
                      Error="@(!string.IsNullOrEmpty(_accountNameError))"
                      ErrorText="@_accountNameError"
                      Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Success" OnClick="Submit">Konto anlegen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? AccountName { get; set; } = default!;

    private string? _accountNameError = default!;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(AccountName))
        {
            _accountNameError = "Das Konto benötigt einen Namen!";
        }
        else
        {
            MudDialog.Close(DialogResult.Ok(AccountName));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}