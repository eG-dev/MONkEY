<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">Wie heißt Dein neues Konto?</MudText>

        <MudTextField T="string"
                      Class="mt-6"
                      Label="Name"
                      Variant="Variant.Outlined"
                      @bind-Value="@AccountName"
                      MaxLength="25"
                      Counter="25"
                      Immediate="false"
                      OnlyValidateIfDirty="true"
                      Validation="@(new Func<string, IEnumerable<string>>(ValidateName))" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.TwoTone.Add"
                   OnClick="Submit">
            Konto hinzufügen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTextField<string?> _accountNameInput = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? AccountName { get; set; } = default!;

    private IEnumerable<string> ValidateName(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            yield return "Das Konto benötigt einen Namen!";
        }
    }

    private async Task Submit()
    {
        await _accountNameInput.ValidateAsync();
        if (_accountNameInput.HasErrors)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(AccountName));
    }

    private void Cancel() => MudDialog.Cancel();
}