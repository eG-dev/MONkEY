@using MONkEY.WebApp.DTO

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info">
            Diese Summe wird monatlich automatisch dem Konto gutgeschrieben.
            <br />
            Änderungen an dem Taschengeld wirken sich erst im nächsten Monat aus wenn das Taschengeld im aktuellen Monat bereits automatisch gutgeschrieben wurde.
        </MudAlert>

        <MudFocusTrap>
            <MudNumericField Label="Monatliches Taschengeld"
                             Class="mt-6"
                             Variant="Variant.Text"
                             Min="0"
                             Max="1000"
                             Step="0.01"
                             @bind-Value="PocketMoney"
                             Immediate="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Wallet" />
        </MudFocusTrap>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.TwoTone.Wallet"
                   OnClick="Submit">
            Taschengeld festlegen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public double? PocketMoney { get; set; } = default!;

    private void Submit()
    {
        var model = new PocketMoneyDialogModel()
        {
            PocketMoney = PocketMoney ?? 0.0
        };

        MudDialog.Close(DialogResult.Ok(model));
    }

    private void Cancel() => MudDialog.Cancel();
}