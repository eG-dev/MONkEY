<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info">
            Diese Summe wird monatlich automatisch dem Konto gutgeschrieben.
            <br />
            Änderungen an dem Taschengeld wirken sich erst im nächsten Monat aus wenn das Taschengeld im aktuellen Monat bereits automatisch gutgeschrieben wurde.
        </MudAlert>

        <MudFocusTrap>
            <MudNumericField @ref="_amountInput"
                             Label="Monatliches Taschengeld"
                             Class="mt-6"
                             Variant="Variant.Text"
                             Min="0"
                             Max="1000"
                             Step="1"
                             Format="N2"
                             @bind-Value="Allowance"
                             Immediate="false"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Wallet" />
        </MudFocusTrap>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.TwoTone.Check"
                   OnClick="Submit">
            Taschengeld festlegen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudNumericField<double?> _amountInput = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public double? Allowance { get; set; } = default!;

    private async Task Submit()
    {
        await _amountInput.ValidateAsync();
        if (_amountInput.HasErrors)
        {
            return;
        }

        var amount = Math.Round(Allowance ?? 0.0, 2);

        MudDialog.Close(DialogResult.Ok(amount));
    }

    private void Cancel() => MudDialog.Cancel();
}