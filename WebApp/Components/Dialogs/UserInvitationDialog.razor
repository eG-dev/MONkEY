@using System.Net.Mail

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info">
            Gib hier die E-Mail-Adresse des Microsoft-Kontos ein, mit dem sich der Nutzer einloggen wird.
        </MudAlert>

        <MudFocusTrap>
            <MudTextField @ref="_emailInput"
                          @bind-Value="_model.Email"
                          Class="mt-3"
                          T="string"
                          Label="E-Mail"
                          Variant="Variant.Outlined"
                          OnlyValidateIfDirty="true"
                          Validation="@(new Func<string, IEnumerable<string>>(ValidateEmail))" />
        </MudFocusTrap>

        <MudAlert Class="mt-6" Severity="Severity.Info">
            Ein Verwalter kann die Höhe des Taschengeldes festlegen, Guthaben verwalten und andere Nutzer einladen.
            <br />
            Ein Nutzer kann nur lesend auf die Daten zugreifen und auch sonst keine administrativen Aufgaben durchführen.
        </MudAlert>

        <MudCheckBox Class="mt-3" @bind-Value="_model.AssignManagerRole">
            Dem Nutzer die Verwalter-Rolle zuweisen.
        </MudCheckBox>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.TwoTone.Add"
                   Disabled="_emailInput?.HasErrors ?? true"
                   OnClick="Submit">
            Nutzer hinzufügen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly InvitationDialogModel _model = new();

    private MudTextField<string> _emailInput = default!;

    private IEnumerable<string> ValidateEmail(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            yield return "Eine gültige E-Mail wird benötigt!";
        }
        else
        {
            string? address = null; 

            try
            {
                address = new MailAddress(text).Address;
            }
            catch (FormatException) {}

            if (string.IsNullOrEmpty(address))
            {
                yield return "Eine gültige E-Mail wird benötigt!";
            }
        }
    }

    private async Task Submit()
    {
        await _emailInput.ValidateAsync();
        if (_emailInput.HasErrors)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}