@using MONkEY.WebApp.DTO

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">Möchtest Du das Konto von <b>@AccountName</b> wirklich löschen?</MudText>

        <MudAlert Class="mt-6" Severity="Severity.Warning">
            Alle dazugehörigen Daten werden unwiderruflich gelöscht!
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.TwoTone.Delete"
                   OnClick="Submit">
            Konto löschen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? AccountName { get; set; } = default!;

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}