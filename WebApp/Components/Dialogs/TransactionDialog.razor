<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1">Aktuelles Guthaben</MudText>
        <MudText Typo="Typo.body1" Class="mb-6">
            <Amount Value="@CurrentBalance" Unit="€" IsBold="true" />
        </MudText>

        <MudFocusTrap>
            <MudNumericField @ref="@_amountInput"
                             @bind-Value="_model.Amount"
                             Label="Betrag"
                             Variant="Variant.Text"
                             Style="@(PayOut ? "color: var(--mud-palette-error)" : "color: var(--mud-palette-success)")"
                             Min="0"
                             Max="1000"
                             Step="1"
                             Format="N2"
                             Immediate="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@(PayOut ? Icons.Material.TwoTone.Remove : Icons.Material.TwoTone.Add)"
                             AdornmentColor="@(PayOut ? Color.Error : Color.Success)"
                             OnlyValidateIfDirty="true"
                             Validation="@(new Func<double?, IEnumerable<string>>(ValidateAmount))" />
        </MudFocusTrap>

        <MudTextField T="string"
                      Label="Kommentar"
                      Variant="Variant.Outlined"
                      @bind-Value="@_model.Comment"
                      MaxLines="5"
                      AutoGrow="true"
                      MaxLength="100" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(PayOut ? Color.Error : Color.Success)"
                   StartIcon="@(PayOut ? Icons.Material.TwoTone.Remove : Icons.Material.TwoTone.Add)"
                   Disabled="_amountInput?.HasErrors ?? true"
                   OnClick="Submit">
            @(PayOut ? "Auszahlen" : "Einzahlen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public bool PayOut { get; set; } = false;

    [Parameter]
    public double CurrentBalance { get; set; }

    private MudNumericField<double?> _amountInput = default!;

    private TransactionDialogModel _model = new();

    private IEnumerable<string> ValidateAmount(double? amount)
    {
        if (amount == null)
        {
            yield return "Ein gültiger Betrag wird benötigt!";
        }
        else if (amount == 0.0)
        {
            yield return "Der Betrag darf nicht 0 sein!";
        }
    }

    private async Task Submit()
    {
        await _amountInput.Validate();

        if (!_amountInput.HasErrors)
        {
            _model.Amount = Math.Round(_model.Amount ?? 0.0, 2);

            if (PayOut)
            {
                _model.Amount = 0 - _model.Amount;
            }

            MudDialog.Close(DialogResult.Ok(_model));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}