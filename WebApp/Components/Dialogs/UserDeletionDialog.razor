@using MONkEY.WebApp.DTO

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">Möchtest Du den Nutzer <b>@Email</b> wirklich löschen?</MudText>

        <MudAlert Class="mt-6" Severity="Severity.Warning">
            Dieser Nutzer wird aus dem System entfernt.
            <br />
            Infolgedessen muss sich die Person erneut anmelden oder eingeladen werden.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.TwoTone.Remove"
                   OnClick="Submit">
            Nutzer löschen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? Email { get; set; } = default!;

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}