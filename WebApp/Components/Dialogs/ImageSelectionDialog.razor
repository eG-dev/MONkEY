@using Cropper.Blazor.Components
@using Cropper.Blazor.Exceptions
@using Cropper.Blazor.Extensions
@using Cropper.Blazor.Models
@using Cropper.Blazor.Services

@inject IUrlImageInterop UrlImageInterop

<MudDialog>
    <DialogContent>
        <div class="image-selector">
            <div class="image-selector-buttons">
                <MudFileUpload T="IBrowserFile" Accept=".png, .jpg, .jpeg" FilesChanged="LoadImageAsync" MaximumFileCount="1">
                    <CustomContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.TwoTone.Image"
                                   OnClick="@context.OpenFilePickerAsync">
                            Bild auswählen
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            </div>
            <div class="image-selector-container my-3">
                <CropperComponent Class="image-selector-cropper"
                                  Options="@CropperOptions"
                                  Src="@Src"
                                  @ref="CropperComponent" />

                <PageLoader @bind-IsActive="_isLoading" AsOverlay="true" IndicatorColor="Color.Secondary" />
            </div>
        </div>

        <style>
            .image-selector {
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
                align-items: flex-start;
                height: 80%;
                width: 100%;
                max-height: 80%;
                max-width: 100%;
            }

            .image-selector-container {
                max-height: calc(100% - 36.5px - 12px - 12px);
                height: calc(100% - 36.5px - 12px - 12px);
                width: 100%;
            }

            .image-selector-cropper {
                max-height: 512px;
                max-width: 512px;
            }

            .cropper-error-load {
                max-height: 100%;
                max-width: 100%;
            }

            .center {
                display: block;
                margin-left: auto;
                margin-right: auto;
            }
        </style>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.TwoTone.Check"
                   OnClick="Submit">
            Bild ändern
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Src { get; set; } = string.Empty;

    private readonly Options CropperOptions = new Options()
        {
            AspectRatio = 1,
            ViewMode = ViewMode.Vm2,
            DragMode = DragMode.Move.ToEnumString()!,
            AutoCrop = true,
            AutoCropArea = 1,
        };

    private CropperComponent? CropperComponent = default!;

    private bool _isLoading = false;

    public async Task LoadImageAsync(IBrowserFile imageFile)
    {
        if (imageFile != null)
        {
            _isLoading = true;

            StateHasChanged();

            var oldSrc = Src;
            Src = await UrlImageInterop.GetImageUsingStreamingAsync(imageFile, imageFile.Size);

            Destroy(oldSrc);

            _isLoading = false;
        }
    }

    private void Destroy(string imageSrc)
    {
        if (!string.IsNullOrEmpty(imageSrc))
        {
            CropperComponent?.Destroy();
            UrlImageInterop?.RevokeObjectUrlAsync(imageSrc);
        }
    }

    private async Task Submit()
    {
        var imageReceiver = await CropperComponent!.GetCroppedCanvasDataInBackgroundAsync(
            new GetCroppedCanvasOptions()
            {
                Width = 512,
                Height = 512,
                FillColor = "white"
            },
            "image/png",
            1 // quality
        );

        try
        {
            using MemoryStream croppedCanvasDataStream = await imageReceiver.GetImageChunkStreamAsync();
            byte[] croppedCanvasData = croppedCanvasDataStream.ToArray();

            var croppedCanvasDataURL = "data:image/png;base64," + Convert.ToBase64String(croppedCanvasData);
            var imageData = croppedCanvasDataURL.Decode();

            ImageSelectionDialogModel model = new()
            {
                ImageDataBase64 = imageData.base64ImageData,
                MediaType = imageData.mediaType,
            };

            MudDialog.Close(DialogResult.Ok(model));
        }
        catch (ImageProcessingException ex)
        {
            throw ex;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
