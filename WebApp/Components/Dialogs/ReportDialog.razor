<MudDialog>
    <DialogContent>
        @switch (Report?.Type)
        {
            case ReportType.Monthly:
                <MonthlyReportDetails Report="Report" />
                break;

            case ReportType.Undefined:
            default:
                <MudAlert Severity="Severity.Error">
                    Der Berichtstyp ist unbekannt.
                </MudAlert>
                break;
        }
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.TwoTone.ForwardToInbox"
                   OnClick="Submit">
            Per E-Mail zusenden
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Cancel">
            Schließen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Report? Report { get; set; } = default!;

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
