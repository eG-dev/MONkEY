<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <Target Name="ValidateMigrationLocation" BeforeTargets="CoreCompile">
    <ItemGroup>
      <MisplacedMigration Include="**/??????????????_*.cs;**/*ModelSnapshot.cs"
                          Exclude="Migrations/**;bin/**;obj/**" />
    </ItemGroup>
    <Error Condition="'@(MisplacedMigration)' != ''"
           Text="EF migrations and the model snapshot must live in PocketMonkey.Storage/Migrations. Misplaced files: @(MisplacedMigration). Use the migration command documented in revamp/README.md." />
  </Target>
</Project>