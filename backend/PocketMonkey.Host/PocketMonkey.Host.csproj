<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PocketMonkey.Storage/PocketMonkey.Storage.csproj" />
  </ItemGroup>
  <Target Name="ValidateMigrationLocation" BeforeTargets="CoreCompile">
    <ItemGroup>
      <MisplacedMigration Include="**/??????????????_*.cs;**/*ModelSnapshot.cs"
                          Exclude="bin/**;obj/**" />
    </ItemGroup>
    <Error Condition="'@(MisplacedMigration)' != ''"
           Text="EF migrations and the model snapshot must live in PocketMonkey.Storage/Migrations. Misplaced files: @(MisplacedMigration). Use the migration command documented in docs/development.md." />
  </Target>
</Project>