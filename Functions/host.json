{
    "version": "2.0",
    "extensions": {
        "queues": {
            "maxPollingInterval": "00:01:00",
            "visibilityTimeout": "00:00:00",
            "maxDequeueCount": 2,
            "batchSize": 16,
            "newBatchThreshold": 8
        }
    },
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    }
}