                <mxCell id="retired-name" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#FFFFFF;strokeColor=#CCCCCC;align=left;spacingLeft=12;fontColor=#1F4E9E;" value="Alex" vertex="1">
