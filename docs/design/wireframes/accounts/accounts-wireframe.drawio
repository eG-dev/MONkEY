                </mxCell>
                <mxCell id="retired-actions" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#FFFFFF;strokeColor=#666666;align=right;spacingLeft=12;spacingRight=12;strokeColor=#CCCCCC;fontColor=#1F4E9E;" value="&gt;" vertex="1">
                    <mxGeometry height="52" width="80" x="1936" y="628" as="geometry"/>
                </mxCell>
                <mxCell id="retirement-list-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="&lt;b&gt;Scheduled for deletion&lt;/b&gt;&lt;br&gt;Managers see retired accounts here, separate from active accounts. Names and chevrons open read-only details; show the scheduled deletion date. Omit the section when empty. Reactivation is available only in account details.&lt;br&gt;&lt;br&gt;Phone: stack the name and date without clipping; the name opens details." vertex="1">
                    <mxGeometry height="270" width="480" x="40" y="427" as="geometry"/>
                </mxCell>
                <mxCell id="annotation-arrow-retirement-list" edge="1" parent="1" source="retirement-list-note" style="rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=none;curved=0;strokeWidth=3;" target="retired-heading">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="undefined-33" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="Dedicated view for account management. The navigation entry is visible to Managers only." vertex="1">
                    <mxGeometry height="90" width="480" x="1080" y="-100" as="geometry"/>
                </mxCell>
                <mxCell id="undefined-34" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="Columns: Name, Balance, Allowance, Status, chevron. Name has a capped width. Balance and Allowance are right-aligned. Additional desktop width is allocated to Status. Allowance shows the configured monthly amount or &quot;No monthly allowance&quot;.&lt;br&gt;&lt;br&gt;Names are links without underlines, with hover feedback and visible keyboard focus. The chevron opens account details. Renaming is available via the pencil in account details; allowance configuration is also in account details.&lt;br&gt;&lt;br&gt;Phone: avatar/name share a 44px-minimum link on the left; muted status is below the name. Balance is on the right, with Allowance directly below it. No separate status or chevron column. Names and amounts wrap without overlap." vertex="1">
                    <mxGeometry height="300" width="480" x="40" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="undefined-36" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="&lt;b&gt;Create dialog only&lt;/b&gt;&lt;br&gt;Field: Name (1-40 characters, unique). Buttons: Cancel and Create account. On success open account details; new accounts are not initialized. Rename and image changes are available only in account details. Full-screen on phones.&lt;br&gt;&lt;br&gt;&lt;b&gt;Creation validation&lt;/b&gt;&lt;br&gt;Errors are announced, including duplicate names. Input is kept on errors and retries. No existing name, balance, or history is editable in this list." vertex="1">
                    <mxGeometry height="200" width="480" x="2120" y="58" as="geometry"/>
                </mxCell>
                <mxCell id="annotation-arrow-undefined-33" edge="1" parent="1" source="undefined-33" style="rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=none;curved=0;strokeWidth=3;exitDx=0;exitDy=0;exitPerimeter=0;entryDx=0;entryDy=0;" target="undefined-2">
