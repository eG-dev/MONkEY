                <mxCell id="assigned-accounts-lena" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#FFFFFF;strokeColor=#CCCCCC;align=left;spacingLeft=12;spacingRight=12;" value="Lena" vertex="1">
