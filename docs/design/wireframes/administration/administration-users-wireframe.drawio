        <mxCell id="undefined-38" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="Managers only. The last active Manager cannot be disabled or demoted; the related controls are disabled with an explanation." vertex="1">
          <mxGeometry x="24" y="520" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="undefined-39" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="No delete. Phone: list with an actions menu per user." vertex="1">
          <mxGeometry x="470" y="520" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="undefined-40" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="&lt;b&gt;Create user dialog&lt;/b&gt;&lt;br&gt;Username (sign-in name, not changeable later), display name (up to 100 characters), role (Member / Manager). Then a second step shows the &lt;b&gt;temporary password&lt;/b&gt; once with Copy and Done: never shown again, the user must change it at the first sign-in." vertex="1">
          <mxGeometry x="24" y="670" width="440" height="220" as="geometry" />
        </mxCell>
        <mxCell id="undefined-41" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="&lt;b&gt;Edit user dialog&lt;/b&gt;&lt;br&gt;Display name, role, Active switch, and &quot;Reset password&quot;. Role change or disabling ends the user's sessions. For the last active Manager, &quot;Member&quot; and &quot;Active&quot; are disabled with the reason shown." vertex="1">
          <mxGeometry x="490" y="670" width="440" height="220" as="geometry" />
        </mxCell>
        <mxCell id="undefined-42" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="&lt;b&gt;Reset password&lt;/b&gt;&lt;br&gt;Asks for confirmation, then shows the new temporary password once (same step as when creating). Existing sessions of that user end." vertex="1">
          <mxGeometry x="956" y="670" width="440" height="220" as="geometry" />
        </mxCell>
