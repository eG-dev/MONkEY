                </mxCell>
                <mxCell id="undefined-16" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="No email recovery: Managers reset passwords in Administration." vertex="1">
                    <mxGeometry height="83" width="480" x="2620" y="795" as="geometry"/>
                </mxCell>
                <mxCell id="sNdbuL23PBqq-89-687P-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="Notes/errors" vertex="1">
                    <mxGeometry height="48" width="400" x="1360" y="476" as="geometry"/>
                </mxCell>
                <mxCell id="sNdbuL23PBqq-89-687P-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="The area for notes/errors is hidden when there are none.&lt;br&gt;&lt;br&gt;&lt;b&gt;Errors&lt;/b&gt; (in the notes area): incorrect username or password, without saying which; locked after 5 failed attempts (try again in 15 minutes); sign-in temporarily unavailable. The username is kept, the password is cleared.&lt;br&gt;&lt;br&gt;&lt;b&gt;Session expired&lt;/b&gt;: info note &quot;Your session has expired. Please sign in again.&quot; Sessions end after 8 hours or when a Manager resets the password, changes the role, or disables the user." vertex="1">
                    <mxGeometry height="202" width="480" x="2620" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="login-note-3" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="&lt;b&gt;Forced password change&lt;/b&gt;: after the first sign-in or a password reset, the card shows &quot;Change your password&quot; with an info note, current password, new password (at least 12 characters), &quot;Change password&quot;, and a &quot;Sign out&quot; link. Afterwards the user signs in again.&lt;br&gt;&lt;br&gt;&lt;b&gt;Phone&lt;/b&gt;: full-width form without the card; same states." vertex="1">
                    <mxGeometry height="157" width="480" x="40" y="536.5" as="geometry"/>
                </mxCell>
                <mxCell id="login-footer" parent="1" style="text;html=1;fontFamily=Calibri;fontSize=14;align=center;fontColor=#666666;" value="Version [build version]   |   [GitHub icon] GitHub" vertex="1">
