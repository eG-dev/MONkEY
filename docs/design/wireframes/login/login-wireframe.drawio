                <mxCell id="login-note-1" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.86;position2=0.94;flipV=1;" value="&lt;b&gt;Errors&lt;/b&gt; (in the notes area): incorrect username or password, without saying which; locked after 5 failed attempts (try again in 15 minutes); sign-in temporarily unavailable. The username is kept, the password is cleared." vertex="1">
                    <mxGeometry height="150" width="400" x="280" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="login-note-2" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.86;position2=0.94;flipV=1;" value="&lt;b&gt;Session expired&lt;/b&gt;: info note &quot;Your session has expired. Please sign in again.&quot; Sessions end after 8 hours or when a Manager resets the password, changes the role, or disables the user." vertex="1">
                    <mxGeometry height="130" width="400" x="280" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="login-note-3" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.86;position2=0.94;flipV=1;" value="&lt;b&gt;Forced password change&lt;/b&gt;: after the first sign-in or a password reset, the card shows &quot;Change your password&quot; with an info note, current password, new password (at least 12 characters), &quot;Change password&quot;, and a &quot;Sign out&quot; link. Afterwards the user signs in again." vertex="1">
