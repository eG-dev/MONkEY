                <mxCell id="login-footer-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="Bottom footer in all login states, including phones: build version and GitHub repository link. GitHub is an unavailable placeholder until the new repository URL is agreed; never point to the current repository. Footer flows below tall content without overlap." vertex="1">
