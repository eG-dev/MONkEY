                </mxCell>
                <mxCell id="undefined-14" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="No application shell before sign-in. Fields support password managers (username / current-password autocomplete)." vertex="1">
