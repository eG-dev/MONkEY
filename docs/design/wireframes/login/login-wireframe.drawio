                <mxCell id="undefined-15" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;verticalAlign=middle;spacing=16;" value="Language can be chosen before sign-in; after sign-in the saved preference applies." vertex="1">
