                <mxCell id="tabs-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Shared modal from login or app, for both roles. Close or Escape restores focus; background stays inert. Tab order: Overview (default), Project license, Third-party notices (selected), Legal information. Only third-party content here; operator/privacy content stays last." vertex="1">
