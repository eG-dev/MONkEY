        <mxCell id="tab-license" parent="1" vertex="1" value="Project license" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#f5f5f5;strokeColor=#999999;">
          <mxGeometry x="840" y="330" width="260" height="48" as="geometry" />
        </mxCell>
        <mxCell id="notices-heading" parent="1" vertex="1" value="Third-party notices" style="text;html=1;fontFamily=Calibri;fontSize=20;fontStyle=1;align=left;">
          <mxGeometry x="640" y="410" width="1320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="component-search" parent="1" vertex="1" value="[search icon] Search components" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#999999;">
          <mxGeometry x="640" y="465" width="1360" height="44" as="geometry" />
        </mxCell>
        <mxCell id="component-one" parent="1" vertex="1" value="&gt; Angular     [shipped version]     [license]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#999999;">
          <mxGeometry x="640" y="535" width="1360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="component-two" parent="1" vertex="1" value="&gt; .NET runtime     [shipped version]     [license]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#999999;">
          <mxGeometry x="640" y="583" width="1360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="component-more" parent="1" vertex="1" value="[Further component rows]" style="text;html=1;fontFamily=Calibri;fontSize=16;align=left;">
          <mxGeometry x="640" y="650" width="1320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="tabs-note" parent="1" vertex="1" value="Shared modal from login or app, for both roles. Close / Schließen or Escape restores focus; background stays inert. R5 draft tab order: Overview / Übersicht (default), Project license / Projektlizenz, Third-party notices / Drittanbieterhinweise (selected), Legal information / Rechtliche Hinweise. Only third-party content here; operator/privacy content stays last." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="40" y="200" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="search-note" parent="1" vertex="1" value="Search filters component names. Provide an empty-result state without hiding the tabs or search field. Expanded rows reveal complete applicable licenses, attribution/NOTICE texts and available component/source links. Authoritative texts remain unchanged; controls and status text are German/English." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="2140" y="380" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="inventory-note" parent="1" vertex="1" value="Example rows use placeholders, not verified versions or license assertions. Use a reviewed release-matched inventory covering shipped frontend/backend transitive dependencies, fonts/icons/assets and applicable container/runtime components. Bundle all required legal texts locally; external network access is not required to read them." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="40" y="550" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phone-note" parent="1" vertex="1" value="Desktop: near-full viewport dialog; phone: full-screen. Keep header/tabs visible; scroll the list and expanded texts inside the dialog. Phone search is full-width with single-column rows; wrap metadata/text. Scroll the tab strip horizontally without page overflow. Keyboard-accessible tabs and expansion with visible active/focus states." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="2140" y="650" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tabs-arrow" parent="1" edge="1" source="tabs-note" target="tab-overview" style="edgeStyle=none;curved=0;strokeWidth=3;strokeColor=#000000;startArrow=none;endArrow=classic;endFill=1;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="search-arrow" parent="1" edge="1" source="search-note" target="component-search" style="edgeStyle=none;curved=0;strokeWidth=3;strokeColor=#000000;startArrow=none;endArrow=classic;endFill=1;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inventory-arrow" parent="1" edge="1" source="inventory-note" target="component-one" style="edgeStyle=none;curved=0;strokeWidth=3;strokeColor=#000000;startArrow=none;endArrow=classic;endFill=1;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="phone-arrow" parent="1" edge="1" source="phone-note" target="component-two" style="edgeStyle=none;curved=0;strokeWidth=3;strokeColor=#000000;startArrow=none;endArrow=classic;endFill=1;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
