        </mxCell>
        <mxCell id="close" parent="1" vertex="1" value="&#215;" style="rounded=0;html=1;fontFamily=Calibri;fontSize=28;fillColor=#FFFFFF;strokeColor=#999999;">
          <mxGeometry x="1956" y="230" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="header-rule" parent="1" vertex="1" value="" style="fillColor=#999999;strokeColor=none;">
