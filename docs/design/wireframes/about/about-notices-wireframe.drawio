                <mxCell id="tabs-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Shared modal from login or app, for both roles. Close or Escape restores focus; background stays inert. Tab order: Overview (default), Project license, Third-party notices (selected), Legal information. Only third-party content here; operator/privacy content stays last." vertex="1">
                    <mxGeometry height="129" width="480" x="40" y="289.5" as="geometry"/>
                </mxCell>
                <mxCell id="search-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Search includes component and package names. A matching package retains its complete parent entry and explicit document applicability. Keep the tabs/search visible for empty results. Preserve group/document expansion across filtering and tab changes; closing the dialog resets it. Controls/status text are German/English; original legal texts are not translated." vertex="1">
                    <mxGeometry height="180" width="480" x="2140" y="397" as="geometry"/>
                </mxCell>
                <mxCell id="inventory-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Each expanded entry contains clearly bounded package/license groups. Show applicable packages once per group, with individual source links. Put shared version/license metadata in the group heading; retain individual metadata when members differ. Give each document a readable title and independent expansion, initially closed. Open original always opens the locally bundled file without toggling its body. The illustrated MIT body is open only to show the pattern: expansion reveals the complete unchanged text and pushes later groups down. Do not repeat package lists before every document. This partial collection is not release approval." vertex="1">
                    <mxGeometry height="196" width="480" x="40" y="565" as="geometry"/>
                </mxCell>
                <mxCell id="phone-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Desktop: near-full viewport dialog; phone: full-screen. Stack group metadata below its heading and wrap package names, document titles and links. Keep header/tabs visible; use one scrolling content area, not nested legal-text scrollers. Document expansion uses keyboard-accessible controls with clear focus/state. Group borders, headings and spacing distinguish sections without relying on color. Tab-strip scrolling must not cause page overflow." vertex="1">
                    <mxGeometry height="180" width="480" x="2150" y="761" as="geometry"/>
                </mxCell>
