                <mxCell id="access-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="One shared About / Info modal opens over login or the app, for both roles. Desktop: near-full viewport; phone: full-screen. Close icon (Close / Schließen) and Escape dismiss it and restore focus to its opener. Trap focus; background is inert. Keep header/tabs visible; scroll content internally. Retain current language/theme. No authentication or consent gate." vertex="1">
                    <mxGeometry height="170" width="480" x="40" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="source-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Show only public version/revision metadata. GitHub and source access move here from the shell/login footer. Repository URL remains unavailable until agreed. Source must match this release; do not substitute the latest branch. Never invent URLs or expose deployment diagnostics." vertex="1">
                    <mxGeometry height="160" width="480" x="2140" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="license-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="The project license moves to its own second tab: Project license / Projektlizenz. Overview contains only project/version/source information. The license tab shows the complete bundled, unmodified AGPLv3 text immediately, without an expandable row. Project grant remains version 3 only." vertex="1">
                    <mxGeometry height="160" width="480" x="2140" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="notices-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="R5 draft tab order: Overview / Übersicht (default), Project license / Projektlizenz, Third-party notices / Drittanbieterhinweise, Legal information / Rechtliche Hinweise. Operator/privacy content stays on the last tab. Each tab has its own wireframe. Keyboard-accessible tabs and visible active state; scroll the tab strip on phones without page overflow." vertex="1">
                    <mxGeometry height="200" width="480" x="40" y="650" as="geometry"/>
                </mxCell>
