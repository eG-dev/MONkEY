                <mxCell id="source-links" parent="1" style="text;html=1;fontFamily=Calibri;fontSize=16;align=left;fontStyle=4;" value="[GitHub icon] GitHub project     [code icon] Source for this version" vertex="1">
                    <mxGeometry height="40" width="1320" x="640" y="500" as="geometry"/>
