                <mxCell id="tabs-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Tab order: Overview (default), Project license (selected), Third-party notices, Legal information. Shared modal, public and both roles. Keyboard tabs, Close/Escape and opener focus return remain unchanged. No consent or acceptance gate." vertex="1">
                    <mxGeometry height="180" width="480" x="40" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="license-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;" value="Show the entire canonical project-license text immediately when selecting this tab. No details/summary, accordion, expand button or collapsed state. Preserve the bundled AGPL text verbatim, including line breaks; translate navigation/labels only. Project license remains AGPL-3.0-only. The dashed text box represents flowing text, not a framed fixed-height tool." vertex="1">
                    <mxGeometry height="200" width="480" x="2140" y="500" as="geometry"/>
                </mxCell>
