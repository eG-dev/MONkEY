                <mxCell id="license-text" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;align=left;verticalAlign=top;spacing=16;fillColor=none;strokeColor=#999999;dashed=1;" value="GNU AFFERO GENERAL PUBLIC LICENSE&lt;br&gt;Version 3, 19 November 2007&lt;br&gt;&lt;br&gt;[Complete, unmodified bundled license text is immediately visible here and continues below the viewport.]" vertex="1">
