        </mxCell>
        <mxCell id="warranty-content" parent="1" vertex="1" value="[Reviewed warranty/liability information, subject to applicable law and consistent with AGPL]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;align=left;verticalAlign=top;spacing=16;fillColor=none;strokeColor=#999999;dashed=1;">
          <mxGeometry x="640" y="625" width="1360" height="90" as="geometry" />
