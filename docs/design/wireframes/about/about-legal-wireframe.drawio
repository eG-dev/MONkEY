        <mxCell id="tab-legal" parent="1" vertex="1" value="Legal information" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;">
          <mxGeometry x="1140" y="330" width="300" height="48" as="geometry" />
