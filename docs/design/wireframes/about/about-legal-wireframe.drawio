          <mxGeometry x="640" y="410" width="1320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="operator-content" parent="1" vertex="1" value="[Reviewed operator information: hosting, access/security, updates, backups and recovery]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;align=left;verticalAlign=top;spacing=16;fillColor=none;strokeColor=#999999;dashed=1;">
          <mxGeometry x="640" y="455" width="1360" height="100" as="geometry" />
