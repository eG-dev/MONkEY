        <mxCell id="privacy-heading" parent="1" vertex="1" value="Privacy information" style="text;html=1;fontFamily=Calibri;fontSize=20;fontStyle=1;align=left;">
          <mxGeometry x="640" y="745" width="1320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="privacy-content" parent="1" vertex="1" value="[Reviewed privacy information: actual instance data processing and the instance operator's responsibilities]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;align=left;verticalAlign=top;spacing=16;fillColor=none;strokeColor=#999999;dashed=1;">
          <mxGeometry x="640" y="790" width="1360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tabs-note" parent="1" vertex="1" value="Last tab: Legal information / Rechtliche Hinweise. Distinct operator, warranty/liability and privacy sections in the same modal from login or app, for both roles. Retain current language/theme. Close / Schließen or Escape restores focus to the opener; background stays inert. No consent gate or per-user acceptance state." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="2140" y="200" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="operator-note" parent="1" vertex="1" value="Placeholder structure only, not approved legal wording. Distinguish the person operating the instance from household users and project maintainers. Review hosting, access/HTTPS, configuration, updates, storage and backups/recovery responsibilities. No invented operator identity, contact or hosting promise." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="40" y="400" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="warranty-note" parent="1" vertex="1" value="Wording remains subject to review. Qualify warranty/liability statements by mandatory law; do not promise absolute immunity, a service-level agreement or continued maintenance/support. This information must not restrict AGPL rights or replace the project license on Overview." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="2140" y="560" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="privacy-note" parent="1" vertex="1" value="Privacy is a distinct section, not a liability disclaimer. Describe actual local processing and operator responsibilities after review; do not imply project maintainers host household data or reuse cloud legal texts. Publish no household/user details. German/English content must be reviewed separately from this layout." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="40" y="760" width="480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="phone-note" parent="1" vertex="1" value="Desktop: near-full viewport dialog; phone: full-screen with one readable column. Header/tabs remain visible; content scrolls internally. Text grows naturally; dashed boxes are placeholders, not fixed-height panels. Scroll the tab strip horizontally without page overflow. Accessible tabs and visible focus. Bundle required content locally." style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;align=left;spacing=16;">
          <mxGeometry x="2140" y="800" width="480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="tabs-arrow" parent="1" edge="1" source="tabs-note" target="tab-legal" style="edgeStyle=none;curved=0;strokeWidth=3;strokeColor=#000000;startArrow=none;endArrow=classic;endFill=1;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
