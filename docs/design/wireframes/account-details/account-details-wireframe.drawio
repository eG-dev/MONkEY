        <mxCell id="undefined-58" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=16;align=center;verticalAlign=middle;fontColor=#000000;" value="Page 1" vertex="1">
          <mxGeometry x="640" y="496" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="undefined-59" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#FFFFFF;strokeColor=#666666;" value="Next ›" vertex="1">
          <mxGeometry x="772" y="496" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="undefined-60" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;" value="Managers: avatar edits the image (PNG/JPEG/WebP); pencil beside the heading renames (1-40 characters, unique). Errors keep input; Cancel keeps the name. Members see no edit controls. Rename is available only on this page." vertex="1">
          <mxGeometry x="300" y="8" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="undefined-61" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;" value="Right-aligned actions: icon-only refresh, then labelled Record transaction for Managers with an opening balance. On phones the action group wraps together onto a right-aligned line. Rename stays beside the name." vertex="1">
          <mxGeometry x="24" y="610" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="undefined-62" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="Managers only. The mode is shown by color plus sign: deposit green (+), withdrawal red (−) on the selected toggle, the amount sign, and the button. Submitting disables the button until the backend confirms; retries reuse the same request so nothing is booked twice. Withdrawals may make the balance negative." vertex="1">
          <mxGeometry x="24" y="806" width="440" height="186" as="geometry" />
        </mxCell>
        <mxCell id="undefined-63" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="Newest first, 20 per page. Dates in the business timezone, formatted for the language. Amounts signed and colored. Without transactions: &quot;No transactions yet&quot;." vertex="1">
          <mxGeometry x="492" y="580" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="undefined-64" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="&lt;b&gt;Not initialized&lt;/b&gt;&lt;br&gt;The balance shows &quot;Not initialized&quot;. Managers get an &quot;Opening amount&quot; form instead of &quot;Record transaction&quot;: signed amount (may be zero or negative), optional comment, &quot;Post opening amount&quot;. Final once posted, so a confirmation dialog asks before posting. Members see a note instead." vertex="1">
          <mxGeometry x="966" y="580" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="undefined-65" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="&lt;b&gt;Monthly allowance&lt;/b&gt;&lt;br&gt;Amount per month or &quot;No monthly allowance&quot;; status &quot;Credited this month on …&quot; or &quot;Next credit on …&quot;; Managers also see failed credits with the reason. Managers: &quot;Set allowance&quot; opens a dialog (amount ≥ 0, on/off). Credits appear in the history as &quot;Allowance&quot; by &quot;Automatic&quot;. Saving never books money itself." vertex="1">
          <mxGeometry x="492" y="780" width="450" height="190" as="geometry" />
        </mxCell>
        <mxCell id="undefined-66" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="Member: balance, allowance and history only; no business-write controls. Phone: labelled Record transaction stays after refresh in the header and opens a full-screen dialog. Balance, allowance and history remain stacked; amounts are never truncated." vertex="1">
          <mxGeometry x="966" y="780" width="450" height="190" as="geometry" />
        </mxCell>
        <mxCell id="rename-account" parent="1" style="text;html=1;fontFamily=Calibri;fontSize=18;" value="[pencil]" vertex="1"><mxGeometry x="190" y="68" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="refresh-view" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=14;fillColor=#FFFFFF;strokeColor=#666666;" value="[refresh]" vertex="1"><mxGeometry x="1070" y="56" width="96" height="48" as="geometry" /></mxCell>
        <mxCell id="record-transaction" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" value="+ Record transaction" vertex="1"><mxGeometry x="1180" y="56" width="236" height="48" as="geometry" /></mxCell>
