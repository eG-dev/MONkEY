        </mxCell>
        <mxCell id="undefined-59" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Calibri;fontSize=16;fillColor=#FFFFFF;strokeColor=#666666;" value="Next ›" vertex="1">
          <mxGeometry x="772" y="496" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="undefined-60" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;" value="&lt;b&gt;Account image&lt;/b&gt;: shows the image, or the first letter of the name if none is set. Managers click it to upload, replace, or remove the image (PNG, JPEG, WebP); a pencil badge marks it as editable. Members only see it." vertex="1">
          <mxGeometry x="300" y="8" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="undefined-61" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;" value="The shell navigation keeps &quot;Overview&quot; selected; details are reached from an account card or the Accounts list." vertex="1">
          <mxGeometry x="900" y="20" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="undefined-62" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="Managers only. The mode is shown by color plus sign: deposit green (+), withdrawal red (−) on the selected toggle, the amount sign, and the button. Submitting disables the button until the backend confirms; retries reuse the same request so nothing is booked twice. Withdrawals may make the balance negative." vertex="1">
          <mxGeometry x="24" y="806" width="440" height="186" as="geometry" />
        </mxCell>
        <mxCell id="undefined-63" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="Newest first, 20 per page. Dates in the business timezone, formatted for the language. Amounts signed and colored. Without transactions: &quot;No transactions yet&quot;." vertex="1">
          <mxGeometry x="492" y="580" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="undefined-64" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Calibri;fontSize=14;size=24;base=16;position=0.08;position2=0.02;flipV=1;" value="&lt;b&gt;Not initialized&lt;/b&gt;&lt;br&gt;The balance shows &quot;Not initialized&quot;. Managers get an &quot;Opening amount&quot; form instead of &quot;Record transaction&quot;: signed amount (may be zero or negative), optional comment, &quot;Post opening amount&quot;. Final once posted, so a confirmation dialog asks before posting. Members see a note instead." vertex="1">
          <mxGeometry x="966" y="580" width="450" height="170" as="geometry" />
